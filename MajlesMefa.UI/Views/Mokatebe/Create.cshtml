@using MajlesMefa.UI.Views.Category;
@using MajlesMefa.UI.Views.Mokatebe;
@using MajlesMefa.UI.Models;
@using MajlesMefa.UI.Views.Organization;
@using MajlesMefa.UI.Views.Senator;
@{
    ViewData["Title"] = "ایجاد مکاتبه";
}
@model MokatebeVm

<div class="m-portlet">
    <div class="m-portlet__body">
        <form asp-controller=@MokatebeController.CONTROLLER asp-action="Create" id="createMokatebeForm" method="post">
            <div class="row">
                <div asp-validation-summary="ModelOnly"></div>

                <div class="form-group mt-3 col-md-4">
                    <label asp-for="@Model.SenatorId"></label>
                    <input asp-for="@Model.SenatorId" id="SenatorId" class="form-control" />
                    <span asp-validation-for="@Model.SenatorId" class="text-danger"></span>
                </div>

                <div class="form-group mt-3 col-md-4">
                    <label asp-for="@Model.Title">چکیده نامه</label>
                    <input asp-for="@Model.Title" id="Title" class="form-control" />
                    <span asp-validation-for="@Model.Title" class="text-danger"></span>
                </div>


                <div class="form-group mt-3 col-md-4">
                    <label asp-for="@Model.MokatebeData.MokatebeKonandeInt"></label>
                    <input asp-for="@Model.MokatebeData.MokatebeKonandeInt" id="MokatebeKonande" class="form-control" />
                    <span asp-validation-for="@Model.MokatebeData.MokatebeKonandeInt" class="text-danger"></span>
                </div>
                <div class="form-group mt-3 col-md-4">
                    <label asp-for="@Model.MokatebeData.MokatebeTypeInt" class="control-label"></label>
                    <input asp-for="@Model.MokatebeData.MokatebeTypeInt" id="MokatebeType" class="form-control" />
                    <span asp-validation-for="@Model.MokatebeData.MokatebeTypeInt" class="text-danger"></span>
                </div>

                <div class="form-group mt-3 col-md-4">
                    <label asp-for="@Model.MokatebeData.ContactInt" class="control-label"></label>
                    <select asp-for="@Model.MokatebeData.ContactInt" id="Contact" class="form-control" ></select>
                    <span asp-validation-for="@Model.MokatebeData.ContactInt" class="text-danger"></span>
                </div>
               
                <div class="form-group mt-3 col-md-4">
                    <label asp-for="@Model.MokatebeData.ShomareDabirkhane"></label>
                    <input asp-for="@Model.MokatebeData.ShomareDabirkhane" id="ShomareDabirkhane" class="form-control" />
                    <span asp-validation-for="@Model.MokatebeData.ShomareDabirkhane" class="text-danger"></span>
                </div>
                <div class="form-group mt-3 col-md-4">
                    <label asp-for="@Model.TarikhDabirKhane" class="control-label"></label>
                    <div class="input-group">
                        <div class="input-group-prepend">
                            <span class="input-group-text cursor-pointer" id="btnTarikhDabirKhane"><i class="far fa-calendar-alt"></i></span>
                        </div>
                        <input asp-for="@Model.TarikhDabirKhane" class="form-control" />
                    </div>
                    <span class="help-block"><span asp-validation-for="@Model.TarikhDabirKhane" class="text-danger"></span></span>
                </div>
                <div class="form-group mt-3 col-md-4">
                    <label asp-for="@Model.TarikhNamenamaynde" class="control-label"></label>
                    <div class="input-group">
                        <div class="input-group-prepend">
                            <span class="input-group-text cursor-pointer" id="btnTarikhNamenamaynde"><i class="far fa-calendar-alt"></i></span>
                        </div>
                        <input asp-for="@Model.TarikhNamenamaynde" class="form-control" />
                    </div>
                    <span class="help-block"><span asp-validation-for="@Model.TarikhNamenamaynde" class="text-danger"></span></span>
                </div>
                <div class="form-group mt-3 col-md-4">
                    <label asp-for="@Model.MokatebeData.ShomareDabirkhaneMarkazi"></label>
                    <input asp-for="@Model.MokatebeData.ShomareDabirkhaneMarkazi" id="ShomareDabirkhaneMarkazi" class="form-control" />
                    <span asp-validation-for="@Model.MokatebeData.ShomareDabirkhaneMarkazi" class="text-danger"></span>
                </div>

               

                <div class="form-group col-12 mt-4">
                    <input asp-for="@Model.Moshtarak" id="Moshtarak" />
                    <label asp-for="@Model.Moshtarak">معاونت مشترک دارد</label>
                </div>

                <div id="category" class="col-12 row">
                    <div class="form-group mt-3 col-md-4">
                        <label asp-for="@Model.CategoryParentId"></label>
                        <input asp-for="@Model.CategoryParentId" id="CategoryParentId" class="form-control" />
                    </div>
                    <div class="form-group mt-3 col-md-4">
                        <label asp-for="@Model.CategoryId"></label>
                        <input asp-for="@Model.CategoryId" id="CategoryId" class="form-control" />
                        <span asp-validation-for="@Model.CategoryId" class="text-danger"></span>
                    </div>
                </div>


                <div class="form-group mt-3 col-md-12" id="moavenats">
                    <label asp-for="@Model.Moavenats"></label>
                    <select class="form-control" asp-for="@Model.Moavenats" id="Moavenats" multiple="multiple">
                    </select>
                    <span asp-validation-for="@Model.Moavenats" class="text-danger"></span>
                </div>
               

                <div class="form-group mt-3 col-md-12">
                    <label asp-for="@Model.Description"></label>
                    <textarea asp-for="@Model.Description" id="Description" class="form-control" rows="4"></textarea>
                    <span asp-validation-for="@Model.Description" class="text-danger"></span>
                </div>

                <div class="col-12 mt-4">
                    <h5>پیگیری</h5>
                </div>

                <div class="form-group mt-3 col-md-4">
                    <label asp-for="@Model.MokatebeData.PeygiriKonande"></label>
                    <input asp-for="@Model.MokatebeData.PeygiriKonande" id="PeygiriKonande" class="form-control" />
                    <span asp-validation-for="@Model.MokatebeData.PeygiriKonande" class="text-danger"></span>
                </div>

                <div class="form-group mt-3 col-md-4">
                    <label asp-for="@Model.MokatebeData.PeygiriNumber"></label>
                    <input asp-for="@Model.MokatebeData.PeygiriNumber" id="PeygiriNumber" class="form-control" />
                    <span asp-validation-for="@Model.MokatebeData.PeygiriNumber" class="text-danger"></span>
                </div>



                <div class="form-group mt-3 col-md-4">
                    <label asp-for="@Model.TarikhPeygiri" class="control-label"></label>
                    <div class="input-group">
                        <div class="input-group-prepend">
                            <span class="input-group-text cursor-pointer" id="btnTarikhPeygiri"><i class="far fa-calendar-alt"></i></span>
                        </div>
                        <input asp-for="@Model.TarikhPeygiri" class="form-control" />
                    </div>
                    <span class="help-block"><span asp-validation-for="@Model.TarikhPeygiri" class="text-danger"></span></span>
                </div>

                <div class="form-group mt-2 col-md-12">
                    <label asp-for="@Model.MokatebeData.PeygiriDescription"></label>
                    <textarea asp-for="@Model.MokatebeData.PeygiriDescription" id="PeygiriDescription" class="form-control" rows="4"></textarea>
                    <span asp-validation-for="@Model.MokatebeData.PeygiriDescription" class="text-danger"></span>
                </div>
                <div class="col-12 mt-4">
                    <h5>ارجاع</h5>
                </div>
                <div class="form-group col-md-4">
                    <label asp-for="UserId" class="control-label"></label>
                    <select asp-for="UserId" asp-items="Model.UserSelectList" title="لطفا انتخاب کنید..."
                            class="form-control selectpicker show-tick " data-live-search="true"></select>
                    <span class="help-block">
                        <span asp-validation-for="UserId" class="text-danger"></span>
                    </span>
                </div>

            </div>
            <div class="row">
                <div class="submit-btn col-md-3 m-auto">
                    <input id="submitBtn" type="submit" value="ثبت" />
                </div>
            </div>

        </form>
    </div>
</div>
@section scripts{
    <script>
        $(document).ready(function () {

            $("#PeygiriKonande").kendoDropDownList({
                dataTextField: "name",
                dataValueField: "id",
                filter: "contains",
                optionLabel: "یک آیتم انتخاب کنید...",
                dataSource: {
                    transport: {
                        read: {
                            dataType: "json",
                            contentType: 'application/json; charset=utf-8',
                            url: '@Url.Action("GetOrganizationsForDropDown", OrganizationController.CONTROLLER)',
                        },
                        parameterMap: function (options) {
                            return `models=${kendo.stringify(options)}`;
                        }
                    },
                    schema: {
                        data: "data",
                        total: "totalRecords",
                        page: "page",
                        pageSize: "pageSize"
                    },
                    serverFiltering: true
                }
            });

            $("#moavenats").hide();
            $("#category").show();

            $("#Moshtarak").change(function (event) {
                $("#moavenats").toggle();
                $("#category").toggle();
                $("#Moavenats").removeAttr('value');
                $("#CategoryParentId").removeAttr('value');
            });

            $('#Amount').hide();
            $('#btnTarikhDabirKhane').MdPersianDateTimePicker({
                targetTextSelector: '#TarikhDabirKhane',
                dateFormat: 'yyyy-MM-dd',
                dateFormat: 'yyyy-MM-dd',
                isGregorian: false,
                enableTimePicker: false,
                disableBeforeToday: false,
                modalMode: true,
                inLine: false
            });

            $('#btnTarikhNamenamaynde').MdPersianDateTimePicker({
                targetTextSelector: '#TarikhNamenamaynde',
                dateFormat: 'yyyy-MM-dd',
                dateFormat: 'yyyy-MM-dd',
                isGregorian: false,
                enableTimePicker: false,
                disableBeforeToday: false,
                modalMode: true,
                inLine: false
            });

            $('#btnTarikhPeygiri').MdPersianDateTimePicker({
                targetTextSelector: '#TarikhPeygiri',
                dateFormat: 'yyyy-MM-dd',
                dateFormat: 'yyyy-MM-dd',
                isGregorian: false,
                enableTimePicker: false,
                disableBeforeToday: false,
                modalMode: true,
                inLine: false
            });



            $("#MokatebeType").kendoDropDownList({
                dataTextField: "name",
                dataValueField: "id",
                optionLabel: "یک آیتم انتخاب کنید...",
                dataSource: {
                    transport: {
                        read: {
                            dataType: "json",
                            contentType: 'application/json; charset=utf-8',
                            url: '@Url.Action("GetMokatebeTypeForDropDown", MokatebeController.CONTROLLER)',
                        },
                    },
                    serverFiltering: false
                }
            });

            $("#Contact").kendoDropDownList({
                dataTextField: "name",
                dataValueField: "id",
                optionLabel: "یک آیتم انتخاب کنید...",
                dataSource: {
                    transport: {
                        read: {
                            dataType: "json",
                            contentType: 'application/json; charset=utf-8',
                            url: '@Url.Action("GetContactForDropDown", MokatebeController.CONTROLLER)',
                        },
                    },
                    serverFiltering: false
                }
            });


            $("#MokatebeKonande").kendoDropDownList({
                dataTextField: "name",
                dataValueField: "id",
                optionLabel: "یک آیتم انتخاب کنید...",
                dataSource: {
                    transport: {
                        read: {
                            dataType: "json",
                            contentType: 'application/json; charset=utf-8',
                            url: '@Url.Action("GetMokatebeKonandeForDropDown", MokatebeController.CONTROLLER)',
                        },
                    },
                    serverFiltering: false
                }
            });

            $("#CategoryParentId").kendoDropDownList({
                dataTextField: "name",
                dataValueField: "id",
                filter: "contains",
                optionLabel: "یک آیتم انتخاب کنید...",
                dataSource: {
                    transport: {
                        read: {
                            dataType: "json",
                            contentType: 'application/json; charset=utf-8',
                            url: '@Url.Action("GetCategoriesForDropDown", CategoryController.CONTROLLER)',
                        },
                        parameterMap: function (options) {
                            return `models=${kendo.stringify(options)}`;
                        }
                    },
                    schema: {
                        data: "data",
                        total: "totalRecords",
                        page: "page",
                        pageSize: "pageSize"
                    },
                    serverFiltering: true
                }
            });

            $("#Moavenats").kendoMultiSelect({
                includeSelectAllOption: true,
                dataTextField: "name",
                dataValueField: "id",
                filter: "contains",
                optionLabel: "یک آیتم انتخاب کنید...",
                dataSource: {
                    transport: {
                        read: {
                            dataType: "json",
                            contentType: 'application/json; charset=utf-8',
                            url: '@Url.Action("GetCategoriesForMultiSelect", CategoryController.CONTROLLER)',
                        },
                    },
                    schema: {
                        data: "data",
                        total: "totalRecords",
                        page: "page",
                        pageSize: "pageSize"
                    },
                    serverFiltering: false
                }
            });


            $("#CategoryId").kendoDropDownList({
                dataTextField: "name",
                dataValueField: "id",
                filter: "contains",
                optionLabel: "یک آیتم انتخاب کنید...",
                dataSource: {}
            });

            $("#CategoryParentId").change(
                function () {
                    if ($("#CategoryParentId").val()) {
                        var parentId = $("#CategoryParentId").val();
                        $("#CategoryId").kendoDropDownList({
                            dataTextField: "name",
                            dataValueField: "id",
                            filter: "contains",
                            optionLabel: "یک آیتم انتخاب کنید...",
                            dataSource: {
                                transport: {
                                    read: {
                                        dataType: "json",
                                        contentType: 'application/json; charset=utf-8',
                                        url: '@Url.Action("GetCategoriesForDropDown", CategoryController.CONTROLLER)',
                                    },
                                    parameterMap: function (options) {
                                        return `models=${kendo.stringify(options)}&parentId=${parentId}`;
                                    }
                                },
                                schema: {
                                    data: "data",
                                    total: "totalRecords",
                                    page: "page",
                                    pageSize: "pageSize"
                                },
                                serverFiltering: true
                            }
                        });
                    } else {
                        $("#CategoryId").kendoDropDownList({
                            dataTextField: "name",
                            dataValueField: "id",
                            filter: "contains",
                            optionLabel: "یک آیتم انتخاب کنید...",
                            dataSource: {}
                        });
                    }
                })

            //$("#SenatorId").kendoDropDownList({
            //    dataTextField: "name",
            //    dataValueField: "id",
            //    filter: "contains",
            //    template: "<span>#:data.name# -  #:data.hozeCityName#</span>",
            //    optionLabel: "یک آیتم انتخاب کنید...",
            //    dataSource: {
            //        transport: {
            //            read: {
            //                dataType: "json",
            //                contentType: 'application/json; charset=utf-8',
            //                url: '@Url.Action("GetSenatorsForDropDown", SenatorController.CONTROLLER)',
            //            },
            //            parameterMap: function (options) {
            //                return `models=${kendo.stringify(options)}`;
            //            }
            //        },
            //        schema: {
            //            data: "data",
            //            total: "totalRecords",
            //            page: "page",
            //            pageSize: "pageSize"
            //        },
            //        serverFiltering: true
            //    }
            //});

            $("#SenatorId").kendoDropDownList({
                dataTextField: "name",
                dataValueField: "id",
                filter: "contains",
                template: "<span>#:data.name# -  #:data.hozeCityName#</span>",
                optionLabel: "یک آیتم انتخاب کنید...",
                dataSource: {
                    transport: {
                        read: {
                            dataType: "json",
                            contentType: 'application/json; charset=utf-8',
                            url: '@Url.Action("GetSenatorsForDropDown", SenatorController.CONTROLLER)',
                        },
                        parameterMap: function (options) {
                            return `models=${kendo.stringify(options)}`;
                        }
                    },
                    schema: {
                        data: "data",
                        total: "totalRecords",
                        page: "page",
                        pageSize: "pageSize"
                    },
                    serverFiltering: true,
                    filter: function (item) {
                        if (this.filterSource && this.filterSource.filter && this.filterSource.filter.filters.length > 0) {
                            var filter = this.filterSource.filter.filters[0];
                            var searchText = filter.value.toLowerCase();

                            // Search in both name and hozeCityName fields
                            return item.name.toLowerCase().indexOf(searchText) >= 0 ||
                                item.hozeCityName.toLowerCase().indexOf(searchText) >= 0;
                        }
                        return true;
                    }
                },
                filtering: function (e) {
                    // Get the filter value
                    var filterValue = e.filter ? e.filter.value : "";

                    // If server filtering is enabled, we need to modify the filter
                    if (this.dataSource.options.serverFiltering) {
                        // Prevent the default filtering
                        e.preventDefault();

                        // Create a filter with "or" logic for both fields
                        var filter = {
                            logic: "or",
                            filters: [
                                { field: "name", operator: "contains", value: filterValue },
                                { field: "hozeCityName", operator: "contains", value: filterValue }
                            ]
                        };

                        // Apply the custom filter
                        this.dataSource.filter(filter);
                    }
                }
            });

            $("#CategoryId").change(
                function () {
                    var id = $("#CategoryId").val();
                    if (id != "") {
                        $.ajax({
                            url: "@Url.Action("GetCategoryById", CategoryController.CONTROLLER)",
                            type: "POST",
                            data: { categoryId: id },
                            dataType: "json",
                            success: function (response) {
                                if (response.hasAmount) {
                                    $("#Amount").show();
                                } else {
                                    $("#Amount").hide();
                                    $("#amount-input").val('');
                                }
                            }
                        });
                    } else {
                        $("#Amount").hide();
                        $("#amount-input").val('');
                    }
                }
            );
        });

        $("#submitBtn").click(function () {
            var validator = $("#createMokatebeForm").kendoValidator().data('kendoValidator');
            validator.validate();
        });

    </script>
}