@using MajlesMefa.UI.Views.Category;
@using MajlesMefa.UI.Views.Mokatebe;
@using MajlesMefa.UI.Models;
@using MajlesMefa.UI.Views.Senator;
@{
    var firstParentId = Model.CategoryParentId;
    var hasMoshtarak = Model.Moshtarak;
    var notMoshtarak = !(Model.Moshtarak);
    ViewData["Title"] = "ویرایش مکاتبه";
}
@model MokatebeVm

<div class="m-portlet">
    <div class="m-portlet__body">
        <form asp-controller=@MokatebeController.CONTROLLER asp-action="Edit" id="EditMokatebeForm" method="post">
            <div class="row">
                <div asp-validation-summary="ModelOnly"></div>
                <input asp-for="@Model.MokatebeData.Id" hidden />

                <div class="form-group mt-3 col-md-4">
                    <label asp-for="@Model.SenatorId"></label>
                    <input asp-for="@Model.SenatorId" id="SenatorId" class="form-control" />
                    <span asp-validation-for="@Model.SenatorId" class="text-danger"></span>
                </div>

                <div class="form-group mt-3 col-md-4">
                    <label asp-for="@Model.Title">چکیده نامه</label>
                    <input asp-for="@Model.Title" id="Title" class="form-control" />
                    <span asp-validation-for="@Model.Title" class="text-danger"></span>
                </div>

                <div class="form-group mt-3 col-md-4">
                    <label asp-for="@Model.MokatebeData.MokatebeKonandeInt"></label>
                    <input asp-for="@Model.MokatebeData.MokatebeKonandeInt" id="MokatebeKonande" class="form-control" />
                    <span asp-validation-for="@Model.MokatebeData.MokatebeKonandeInt" class="text-danger"></span>
                </div>
                <div class="form-group mt-3 col-md-4">
                    <label asp-for="@Model.MokatebeData.MokatebeTypeInt" class="control-label"></label>
                    <input asp-for="@Model.MokatebeData.MokatebeTypeInt" id="MokatebeType" class="form-control" />
                    <span asp-validation-for="@Model.MokatebeData.MokatebeTypeInt" class="text-danger"></span>
                </div>

                <div class="form-group mt-3 col-md-4">
                    <label asp-for="@Model.MokatebeData.ContactInt" class="control-label"></label>
                    <input asp-for="@Model.MokatebeData.ContactInt" id="Contact" class="form-control" />
                    <span asp-validation-for="@Model.MokatebeData.ContactInt" class="text-danger"></span>
                </div>
               
                <div class="form-group mt-3 col-md-4">
                    <label asp-for="@Model.MokatebeData.ShomareDabirkhane"></label>
                    <input asp-for="@Model.MokatebeData.ShomareDabirkhane" id="ShomareDabirkhane" class="form-control" />
                    <span asp-validation-for="@Model.MokatebeData.ShomareDabirkhane" class="text-danger"></span>
                </div>
                <div class="form-group mt-3 col-md-4">
                    <label asp-for="@Model.MokatebeData.ShomareDabirkhaneMarkazi"></label>
                    <input asp-for="@Model.MokatebeData.ShomareDabirkhaneMarkazi" id="ShomareDabirkhaneMarkazi" class="form-control" />
                    <span asp-validation-for="@Model.MokatebeData.ShomareDabirkhaneMarkazi" class="text-danger"></span>
                </div>

                <div class="form-group mt-3 col-md-4">
                    <label asp-for="@Model.TarikhDabirKhane" class="control-label"></label>
                    <div class="input-group">
                        <div class="input-group-prepend">
                            <span class="input-group-text cursor-pointer" id="btnTarikhDabirKhane"><i class="far fa-calendar-alt"></i></span>
                        </div>
                        <input asp-for="@Model.TarikhDabirKhane" class="form-control" />
                    </div>
                    <span class="help-block"><span asp-validation-for="@Model.TarikhDabirKhane" class="text-danger"></span></span>
                </div>
                <div class="form-group mt-3 col-md-4">
                    <label asp-for="@Model.TarikhNamenamaynde" class="control-label"></label>
                    <div class="input-group">
                        <div class="input-group-prepend">
                            <span class="input-group-text cursor-pointer" id="btnTarikhNamenamaynde"><i class="far fa-calendar-alt"></i></span>
                        </div>
                        <input asp-for="@Model.TarikhNamenamaynde" class="form-control" />
                    </div>
                    <span class="help-block"><span asp-validation-for="@Model.TarikhNamenamaynde" class="text-danger"></span></span>
                </div>

                <div class="form-group col-12 mt-4">
                    <input  asp-for="@Model.Moshtarak" id="Moshtarak" default="@Model.Moshtarak" />
                    <label asp-for="@Model.Moshtarak">معاونت مشترک دارد</label>
                </div>

                <div id="category" class="col-12 row">
                    <div class="form-group mt-3 col-md-4">
                        <label asp-for="@Model.CategoryParentId"></label>
                        <input asp-for="@Model.CategoryParentId" id="CategoryParentId" class="form-control" />
                    </div>
                    <div class="form-group mt-3 col-md-4">
                        <label asp-for="@Model.CategoryId"></label>
                        <input asp-for="@Model.CategoryId" id="CategoryId" class="form-control" />
                        <span asp-validation-for="@Model.CategoryId" class="text-danger"></span>
                    </div>
                </div>


                <div class="form-group mt-3 col-md-12" id="moavenats">
                    <label asp-for="@Model.Moavenats"></label>
                    <select class="form-control" asp-for="@Model.Moavenats" id="Moavenats" multiple="multiple">
                    </select>
                    <span asp-validation-for="@Model.Moavenats" class="text-danger"></span>
                </div>


                <div class="form-group mt-3 col-md-12">
                    <label asp-for="@Model.Description"></label>
                    <textarea asp-for="@Model.Description" id="Description" class="form-control" rows="4"></textarea>
                    <span asp-validation-for="@Model.Description" class="text-danger"></span>
                </div>

                <div class="col-12 mt-4">
                    <p class="text-red font-weight-bold">در صورت اخذ پاسخ، شماره پاسخ را در این قسمت وارد نمایید.</p>
                </div>
                <div class="form-group mt-3 col-md-4">
                    <label asp-for="@Model.MokatebeData.VaziatPasokhInt" class="control-label"></label>
                    <input asp-for="@Model.MokatebeData.VaziatPasokhInt" id="VaziatPasokh" class="form-control" />
                    <span asp-validation-for="@Model.MokatebeData.VaziatPasokhInt" class="text-danger"></span>
                </div>
                <div class="form-group mt-3 col-md-4" id="PasokhNo">
                    <label asp-for="@Model.MokatebeData.PasokhNo"></label>
                    <input type="number" asp-for="@Model.MokatebeData.PasokhNo" id="PasokhNo" class="form-control" />
                    <span asp-validation-for="@Model.MokatebeData.PasokhNo" class="text-danger"></span>
                </div>
                <div class="form-group mt-3 col-md-4">
                    <label asp-for="@Model.PasokhDate" class="control-label"></label>
                    <div class="input-group">
                        <div class="input-group-prepend">
                            <span class="input-group-text cursor-pointer" id="btnPasokhDate"><i class="far fa-calendar-alt"></i></span>
                        </div>
                        <input asp-for="@Model.PasokhDate" class="form-control" />
                    </div>
                    <span class="help-block"><span asp-validation-for="@Model.PasokhDate" class="text-danger"></span></span>
                </div>

            </div>
            <div class="row">
                <div class="submit-btn col-md-3 m-auto">
                    <input type="submit" value="ثبت" />
                </div>
            </div>

        </form>
    </div>
</div>
@section scripts{
    <script>
        $(document).ready(function () {
            var jsonList = '@Html.Raw(Newtonsoft.Json.JsonConvert.SerializeObject(@ViewBag.MoavenatsDefaultValue))';

            var jsList = JSON.parse(jsonList);

            if (jsList) {
                $("#moavenats").show();
                $("#category").hide();
            }else{
                $("#moavenats").hide();
                $("#category").show();
            }
            $("#Moshtarak").change(function (event) {
                $("#moavenats").toggle();
                $("#category").toggle();
            });

            $("#Contact").kendoDropDownList({
                dataTextField: "name",
                dataValueField: "id",
                optionLabel: "یک آیتم انتخاب کنید...",
                dataSource: {
                    transport: {
                        read: {
                            dataType: "json",
                            contentType: 'application/json; charset=utf-8',
                            url: '@Url.Action("GetContactForDropDown", MokatebeController.CONTROLLER)',
                        },
                    },
                    serverFiltering: false
                }
            });

            $("#Moavenats").kendoMultiSelect({
                includeSelectAllOption: true,
                dataTextField: "name",
                dataValueField: "id",
                optionLabel: "یک آیتم انتخاب کنید...",
                value: jsList,
                filter: "contains",
                optionLabel: "یک آیتم انتخاب کنید...",
                dataSource: {
                    transport: {
                        read: {
                            dataType: "json",
                            contentType: 'application/json; charset=utf-8',
                            url: '@Url.Action("GetCategoriesForMultiSelect", CategoryController.CONTROLLER)',
                        },
                    },
                    schema: {
                        data: "data",
                        total: "totalRecords",
                        page: "page",
                        pageSize: "pageSize"
                    },
                    serverFiltering: false
                }
            });

            $('#btnPasokhDate').MdPersianDateTimePicker({
                targetTextSelector: '#PasokhDate',
                dateFormat: 'yyyy-MM-dd',
                isGregorian: false,
                enableTimePicker: false,
                disableBeforeToday: false,
                modalMode: true,
                inLine: false
            });

            $('#btnTarikhDabirKhane').MdPersianDateTimePicker({
                targetTextSelector: '#TarikhDabirKhane',
                dateFormat: 'yyyy-MM-dd',
                dateFormat: 'yyyy-MM-dd',
                isGregorian: false,
                enableTimePicker: false,
                disableBeforeToday: false,
                modalMode: true,
                inLine: false
            });

            $('#btnTarikhNamenamaynde').MdPersianDateTimePicker({
                targetTextSelector: '#TarikhNamenamaynde',
                dateFormat: 'yyyy-MM-dd',
                dateFormat: 'yyyy-MM-dd',
                isGregorian: false,
                enableTimePicker: false,
                disableBeforeToday: false,
                modalMode: true,
                inLine: false
            });

            $("#MokatebeType").kendoDropDownList({
                dataTextField: "name",
                dataValueField: "id",
                optionLabel: "یک آیتم انتخاب کنید...",
                dataSource: {
                    transport: {
                        read: {
                            dataType: "json",
                            contentType: 'application/json; charset=utf-8',
                            url: '@Url.Action("GetMokatebeTypeForDropDown", MokatebeController.CONTROLLER)',
                        },
                    },
                    serverFiltering: false
                }
            });

            $("#VaziatPasokh").kendoDropDownList({
                dataTextField: "name",
                dataValueField: "id",
                optionLabel: "یک آیتم انتخاب کنید...",
                dataSource: {
                    transport: {
                        read: {
                            dataType: "json",
                            contentType: 'application/json; charset=utf-8',
                            url: '@Url.Action("GetVaziatPasokhForDropDown", MokatebeController.CONTROLLER)',
                        },
                    },
                    serverFiltering: false
                }
            });

            $("#MokatebeKonande").kendoDropDownList({
                dataTextField: "name",
                dataValueField: "id",
                optionLabel: "یک آیتم انتخاب کنید...",
                dataSource: {
                    transport: {
                        read: {
                            dataType: "json",
                            contentType: 'application/json; charset=utf-8',
                            url: '@Url.Action("GetMokatebeKonandeForDropDown", MokatebeController.CONTROLLER)',
                        },
                    },
                    serverFiltering: false
                }
            });

            $("#CategoryParentId").kendoDropDownList({
                dataTextField: "name",
                dataValueField: "id",
                filter: "contains",
                optionLabel: "یک آیتم انتخاب کنید...",
                dataSource: {
                    transport: {
                        read: {
                            dataType: "json",
                            contentType: 'application/json; charset=utf-8',
                            url: '@Url.Action("GetCategoriesForDropDown", CategoryController.CONTROLLER)',
                        },
                        parameterMap: function (options) {
                            return `models=${kendo.stringify(options)}`;
                        }
                    },
                    schema: {
                        data: "data",
                        total: "totalRecords",
                        page: "page",
                        pageSize: "pageSize"
                    },
                    serverFiltering: true
                }
            });

            $("#CategoryId").kendoDropDownList({
                dataTextField: "name",
                dataValueField: "id",
                filter: "contains",
                optionLabel: "یک آیتم انتخاب کنید...",
                dataSource: {
                    transport: {
                        read: {
                            dataType: "json",
                            contentType: 'application/json; charset=utf-8',
                            url: '@Url.Action("GetCategoriesForDropDown", CategoryController.CONTROLLER)',
                        },
                        parameterMap: function (options) {
                            return `models=${kendo.stringify(options)}&parentId=@firstParentId`;
                        }
                    },
                    schema: {
                        data: "data",
                        total: "totalRecords",
                        page: "page",
                        pageSize: "pageSize"
                    },
                    serverFiltering: true
                }
            });

            $("#CategoryParentId").change(
                function () {
                    if ($("#CategoryParentId").val()) {
                        console.log("if", $("#CategoryParentId").val());
                        var parentId = $("#CategoryParentId").val();
                        $("#CategoryId").kendoDropDownList({
                            dataTextField: "name",
                            dataValueField: "id",
                            filter: "contains",
                            optionLabel: "یک آیتم انتخاب کنید...",
                            dataSource: {
                                transport: {
                                    read: {
                                        dataType: "json",
                                        contentType: 'application/json; charset=utf-8',
                                        url: '@Url.Action("GetCategoriesForDropDown", CategoryController.CONTROLLER)',
                                    },
                                    parameterMap: function (options) {
                                        return `models=${kendo.stringify(options)}&parentId=${parentId}`;
                                    }
                                },
                                schema: {
                                    data: "data",
                                    total: "totalRecords",
                                    page: "page",
                                    pageSize: "pageSize"
                                },
                                serverFiltering: true
                            }
                        });
                    } else {
                        console.log("hi", $("#CategoryParentId").val());

                        $("#CategoryId").kendoDropDownList({
                            dataTextField: "name",
                            dataValueField: "id",
                            filter: "contains",
                            optionLabel: "یک آیتم انتخاب کنید...",
                            dataSource: {}
                        });
                    }
                });

            $("#SenatorId").kendoDropDownList({
                dataTextField: "name",
                dataValueField: "id",
                filter: "contains",
                template: "<span>#:data.name# -  #:data.hozeCityName#</span>",
                optionLabel: "یک آیتم انتخاب کنید...",
                dataSource: {
                    transport: {
                        read: {
                            dataType: "json",
                            contentType: 'application/json; charset=utf-8',
                            url: '@Url.Action("GetSenatorsForDropDown", SenatorController.CONTROLLER)',
                        },
                        parameterMap: function (options) {
                            return `models=${kendo.stringify(options)}`;
                        }
                    },
                    schema: {
                        data: "data",
                        total: "totalRecords",
                        page: "page",
                        pageSize: "pageSize"
                    },
                    serverFiltering: true
                }
            });

            $("#CategoryId").change(
                function () {
                    var id = $("#CategoryId").val();
                    if (id != "") {
                        $.ajax({
                            url: "@Url.Action("GetCategoryById", CategoryController.CONTROLLER)",
                            type: "POST",
                            data: { categoryId: id },
                            dataType: "json",
                            success: function (response) {
                                if (response.hasAmount) {
                                    $("#Amount").show();
                                } else {
                                    $("#Amount").hide();
                                    $("#amount-input").val('');
                                }
                            }
                        });
                    } else {
                        $("#Amount").hide();
                        $("#amount-input").val('');
                    }
                }
            );

        });

    </script>
}