                title: {
                    text: "تعداد مکاتبات به تفکیک معاونت‌ها/سازمان‌ها"
                },
                legend: {
                    position: "bottom",
                },
                seriesDefaults: {
                    type: 'column',
                    stack: true,
                    width: 3,
                    gap: 20,
                    labels: {
                        visible: true,
                        format: "{0}"
                    }
                },
                seriesColors: ["#910766"],
                series: [{
                    spacing: 0,
                    majorGridLines: {
                        visible: false,
                    },
                    //type: "bar",
                    //name: "نمودار اطلاعات ثبت شده",
                    data: @Html.Raw(Newtonsoft.Json.JsonConvert.SerializeObject(@ViewBag.mokatebeByOrganizationCountData)),
                }],
                categoryAxis: {
                    categories: @Html.Raw(Newtonsoft.Json.JsonConvert.SerializeObject(@ViewBag.mokatebeByOrganizationData)),
                    labels: {
                        //padding: {
                        //    right: 35
                        //},
                        rotation: 90
                    },
                },
                valueAxes: {
                    majorGridLines: {
                        visible: false,
                    },
                },
            });

