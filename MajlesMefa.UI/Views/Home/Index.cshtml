                    </div>
                </div>
                <hr />
                <div class="row m-row--no-padding m-row--col-separator-xl">
                    <div id="soalat-by-organization-chart" class="col-12">
                    </div>
                </div>
                <hr />
                <div class="row m-row--no-padding m-row--col-separator-xl">
                    <div id="soalat-by-city-chart" class="col-12">
                    </div>
                </div>
                <hr />
