@using MajlesMefa.Back.Dtos.DataEntryTypesDtos.Grid;
@using MajlesMefa.Back.Enums;
@using MajlesMefa.Back.Services.Abstractioin;
@{
    var cuser = Context.RequestServices.GetService<ICurrentUserService>().GetCurrentUser();
    ViewData["Title"] = "داشبورد";
}
@model List<DashboardItemDto>


@if (cuser.Roles.FirstOrDefault() == RoleTypeEnum.Admin)
{
    <div class="m-portlet">
        <div class="m-portlet__body">
            <div id="report-box-1">

                <div class="row m-row--no-padding m-row--col-separator-xl">
                    <div id="mokatebe-by-organization-chart" class="col-12">
                    </div>
                </div>
                <hr />
                <div class="row m-row--no-padding m-row--col-separator-xl">
