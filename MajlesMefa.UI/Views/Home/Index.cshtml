                    <div id="molaghat-by-month-chart" class="col-12">
                    </div>
                </div>
                <hr />
                <div class="row m-row--no-padding m-row--col-separator-xl">
                    <div id="molaghat-by-city-chart" class="col-12">
                    </div>
                </div>
                <hr />
                @* <div class="row m-row--no-padding m-row--col-separator-xl">
            <div id="chart" class="col-12">
            </div>
            </div>*@
                @*@if (ViewBag.dashboardMokatebeData[0].value > 0 || ViewBag.dashboardMokatebeData[1].value > 0 || ViewBag.dashboardMokatebeData[2].value > 0 || ViewBag.dashboardMokatebeData[3].value > 0)
            {*@
                <div class="row w-100">
                     <div class="row m-row--no-padding col-6">
                        <div id="mokatebe-pie-chart-deatils" class="col-12">
                        </div>
                    </div>
                    <div class="row m-row--no-padding col-6">
                        <div id="mokatebe-pie-chart" class="col-12">
                        </div>
                    </div>
                </div>
                <hr />
                <div class="row w-100">
                    <div class="row m-row--no-padding col-6">
                        <div id="mokatebe-peynevesht-pie-chart-deatils" class="col-12">
                        </div>
                    </div>
                    <div class="row m-row--no-padding col-6">
                        <div id="mokatebe-peynevesht-pie-chart" class="col-12">
                        </div>
                    </div>
                </div>

                @*}*@

            </div>
        </div>
    </div>
