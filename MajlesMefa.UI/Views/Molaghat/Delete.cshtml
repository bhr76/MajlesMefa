@using MajlesMefa.UI.Views.Ezharat;
@using MajlesMefa.UI.Views.Mokatebe;
@using MajlesMefa.UI.Models;
@using MajlesMefa.UI.Views.Molaghat;

@model MolaghatVm

@{
    Layout = null;
}

<form asp-controller=@MolaghatController.CONTROLLER asp-action="Delete" id="DeleteMolaghatForm" method="post">

    <div class="card" style="margin:10px;">
        <div class="card-header">
            <p class="mb-0">
                <b>حذف ملاقات - شناسه: @Model.MolaghatData.Id</b>
            </p>
        </div>

        <div class="modal-body">

            <div asp-validation-summary="ModelOnly"></div>
            <input asp-for="@Model.MolaghatData.Id" hidden />
            <input asp-for="@Model.MolaghatData" hidden />
            <div class="row">
                <div class="col-12"><br /></div>
            </div>
            <div class="row">
                <div class="form-group col-6">
                    <label asp-for="@Model.SenatorName" class="control-label">نام نماینده</label>
                    <input value="@Model.SenatorName" class="form-control" disabled readonly />
                </div>
                <div class="form-group col-6">
                    <label asp-for="@Model.MolaghatData.Count" class="control-label">تعداد ملاقات</label>
                    <input value="@Model.MolaghatData.Count" class="form-control" disabled readonly />
                </div>
            </div>
            <div class="row"><div class="col-12"><br /></div></div>
            <div class="row"><div class="col-12"><br /></div></div>
            <div class="row">
                <div class="col-12">
                    <div class="alert alert-danger" style="width:90%; margin:auto;">
                        آیا از انجام این عملیات مطمئن هستید؟
                    </div>
                    <br />
                </div>
            </div>


        </div>
        <div class="modal-footer">

            <button onclick="event.preventDefault();saveAndupdate($(this.form), $(this.form).attr('action'), '#report-grid-molaghat');"
                    class="btn btn-danger" perform="action">
                حذف
            </button>
        </div>
    </div>

</form>


