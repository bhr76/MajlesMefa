@using MajlesMefa.UI.Views.Molaghat;
@using MajlesMefa.UI.Views.Peygiri;
@using MajlesMefa.Back.Services.Abstractioin;
@using MajlesMefa.Back.Enums;
@model Guid?

@{
    ViewData["Title"] = "لیست ملاقات";
    var id = Model.HasValue ? Model : Guid.Empty;
    var user = Context.RequestServices.GetService<ICurrentUserService>();
    var role = user.GetCurrentUser().Roles.FirstOrDefault();
}

<div class="home-page">
    <div class="m-portlet__body">
        <div class="k-rtl">
            <div id="report-grid-molaghat"></div>
        </div>

    </div>
</div>

@section scripts{
    <script asp-append-version="true">
        var url_create = '';
        var url_edit = '';
        var url_delete = '';
        var url_get_molaghat = '';
        var fromReportPage = false;
        {
            if ('@id' == null || '@id' == @Guid.Empty) { 
                url_get_molaghat = '@Url.Action(nameof(MolaghatController.GetMolaghat), MolaghatController.CONTROLLER)'; 
            }else {
                url_get_molaghat = '@Url.Action(nameof(MolaghatController.GetMolaghat), MolaghatController.CONTROLLER)' + '?senatorId=@id';
            }

            if (@RoleTypeEnum.Admin.Equals(role).ToString().ToLower() || @RoleTypeEnum.MinistryAdmin.Equals(role).ToString().ToLower() || @RoleTypeEnum.MinistryMember.Equals(role).ToString().ToLower() || @RoleTypeEnum.Organization.Equals(role).ToString().ToLower()) {
                url_create = '@Url.Action(nameof(MolaghatController.Create), MolaghatController.CONTROLLER)';
                url_edit = '@Url.Action(nameof(MolaghatController.Edit), MolaghatController.CONTROLLER)';
                url_delete = '@Url.Action(nameof(MolaghatController.Delete), MolaghatController.CONTROLLER)';
            }
        };
        var url_details = '@Url.Action(nameof(MolaghatController.Details), MolaghatController.CONTROLLER)';
        var url_peygiri = '@Url.Action(nameof(PeygiriController.Index), PeygiriController.CONTROLLER)' + '?dataEntryId=#:id#&dataEntryType=#:dataEntryType#';
        var btns = `<button class="k-button" data-link="${url_details}/?molaghatId=#:id#">جزییات</button>
                                 <a class="k-button mt-1" href="${url_peygiri}"></span> پیگیری ها</a>
                                      #if('${url_delete}' != ''){#<button class="k-button mt-1" data-link="${url_delete}/?molaghatId=#:id#"> حذف </button>#}#
                                         #if('${url_edit}' != ''){# <a class="k-button mt-1" href="${url_edit}?molaghatId=#:id#"><span class="k-icon k-i-edit"></span> ویرایش</a>#}#
                                `;

    </script>
    <script src="~/js/pages/molaghat.js" asp-append-version="true"></script>

}

