@using MajlesMefa.UI.Views.Commission;
@using MajlesMefa.UI.Views.Ezharat;
@using MajlesMefa.UI.Models;
@using MajlesMefa.UI.Views.Mokatebe;
@using MajlesMefa.UI.Views.Molaghat;
@using MajlesMefa.UI.Views.Senator;
@{
    ViewData["Title"] = "ویرایش ملاقات";
}
@model MolaghatVm

<div class="m-portlet">
    <div class="m-portlet__body">
        <form asp-controller=@MolaghatController.CONTROLLER asp-action="Edit" id="EditMolaghatForm" method="post">
            <div class="row">
                <div asp-validation-summary="ModelOnly"></div>
                <input asp-for="@Model.MolaghatData.Id" hidden />

                <div class="form-group mt-3 col-md-4">
                    <label asp-for="@Model.SenatorId"></label>
                    <input asp-for="@Model.SenatorId" id="SenatorId" class="form-control" />
                    <span asp-validation-for="@Model.SenatorId" class="text-danger"></span>
                </div>

              
                <div class="form-group mt-3 col-md-4">
                    <label asp-for="@Model.MolaghatData.Count"></label>
                    <input asp-for="@Model.MolaghatData.Count" id="Count" class="form-control" />
                    <span asp-validation-for="@Model.MolaghatData.Count" class="text-danger"></span>
                </div>


                <div class="form-group mt-3 col-md-4">
                    <label asp-for="@Model.MolaghatData.MahalInt"></label>
                    <input asp-for="@Model.MolaghatData.MahalInt" id="MahalInt" class="form-control" />
                    <span asp-validation-for="@Model.MolaghatData.MahalInt" class="text-danger"></span>
                </div>

                <div class="form-group mt-3 col-md-4">
                    <label asp-for="@Model.MolaghatData.MolaghatTypeInt"></label>
                    <input asp-for="@Model.MolaghatData.MolaghatTypeInt" id="MolaghatTypeInt" class="form-control" />
                    <span asp-validation-for="@Model.MolaghatData.MolaghatTypeInt" class="text-danger"></span>
                </div>

                <div class="form-group mt-3 col-md-4">
                    <label asp-for="@Model.MolaghatData.IsMolaghatBaVazir"></label>
                    <div class="form-check">
                        <input asp-for="@Model.MolaghatData.IsMolaghatBaVazir"
                               checked="@(Model.MolaghatData.IsMolaghatBaVazir ? "checked" : null)"
                        class="form-check-input" type="radio" id="IsMolaghatBaVazirYes" value="true" />
                        <label class="form-check-label" for="IsMolaghatBaVazirYes">بله</label>
                    </div>
                    <div class="form-check">
                        <input asp-for="@Model.MolaghatData.IsMolaghatBaVazir"
                               checked="@(Model.MolaghatData.IsMolaghatBaVazir ? null :"checked" )"
                        class="form-check-input"
                               type="radio" id="IsMolaghatBaVazirNo" value="false" />
                        <label class="form-check-label" for="IsMolaghatBaVazirNo">خیر</label>
                    </div>
                    <span asp-validation-for="@Model.MolaghatData.IsMolaghatBaVazir" class="text-danger"></span>
                </div>

                <div class="form-group mt-3 col-md-4">
                    <label asp-for="@Model.Date" class="control-label"></label>
                    <div class="input-group">
                        <div class="input-group-prepend">
                            <span class="input-group-text cursor-pointer" id="btnTarikh"><i class="far fa-calendar-alt"></i></span>
                        </div>
                        <input asp-for="@Model.Date" class="form-control" />
                    </div>
                    <span class="help-block"><span asp-validation-for="@Model.Date" class="text-danger"></span></span>
                </div>

                <div class="col-12"></div>

                <div class="form-group mt-3 col-md-12">
                    <label asp-for="@Model.Description">چکیده درخواستها و سخنان مطروحه</label>
                    <textarea asp-for="@Model.Description" id="Description" class="form-control" rows="4"></textarea>
                    <span asp-validation-for="@Model.Description" class="text-danger"></span>
                </div>

               <div class="col-12 mt-4">
                    <p class="text-red font-weight-bold">در صورت اخذ پاسخ، شماره پاسخ را در این قسمت وارد نمایید.</p>
                </div>
                <div class="form-group mt-3 col-md-4">
                    <label asp-for="@Model.MolaghatData.PasokhStateInt" class="control-label"></label>
                    <input asp-for="@Model.MolaghatData.PasokhStateInt" id="VaziatPasokh" class="form-control" />
                    <span asp-validation-for="@Model.MolaghatData.PasokhStateInt" class="text-danger"></span>
                </div>
                <div class="form-group mt-3 col-md-4" id="PasokhNo">
                    <label asp-for="@Model.MolaghatData.PasokhNo"></label>
                    <input type="number" asp-for="@Model.MolaghatData.PasokhNo" id="PasokhNo" class="form-control" />
                    <span asp-validation-for="@Model.MolaghatData.PasokhNo" class="text-danger"></span>
                </div>
                <div class="form-group mt-3 col-md-4">
                    <label asp-for="@Model.PasokhDate" class="control-label"></label>
                    <div class="input-group">
                        <div class="input-group-prepend">
                            <span class="input-group-text cursor-pointer" id="btnPasokhDate"><i class="far fa-calendar-alt"></i></span>
                        </div>
                        <input asp-for="@Model.PasokhDate" class="form-control" />
                    </div>
                    <span class="help-block"><span asp-validation-for="@Model.PasokhDate" class="text-danger"></span></span>
                </div>

            </div>
            <div class="row">
                <div class="submit-btn col-md-3 m-auto">
                    <input type="submit" value="ثبت" />
                </div>
            </div>

        </form>
    </div>
</div>
@section scripts{
        <script>
            $(document).ready(function () {

            $("#VaziatPasokh").kendoDropDownList({
                dataTextField: "name",
                dataValueField: "id",
                optionLabel: "یک آیتم انتخاب کنید...",
                dataSource: {
                    transport: {
                        read: {
                            dataType: "json",
                            contentType: 'application/json; charset=utf-8',
                            url: '@Url.Action("GetVaziatPasokhForDropDown", MokatebeController.CONTROLLER)',
                        },
                    },
                    serverFiltering: false
                }
            });

            $('#btnPasokhDate').MdPersianDateTimePicker({
                targetTextSelector: '#PasokhDate',
                dateFormat: 'yyyy-MM-dd',
                isGregorian: false,
                enableTimePicker: false,
                disableBeforeToday: false,
                modalMode: true,
                inLine: false
            });

            $("#Commission").kendoDropDownList({
                dataTextField: "title",
                dataValueField: "id",
                filter: "contains",
                optionLabel: "یک آیتم انتخاب کنید...",
                dataSource: {
                    transport: {
                        read: {
                            dataType: "json",
                            contentType: 'application/json; charset=utf-8',
                            url: '@Url.Action("GetCommission", CommissionController.CONTROLLER)',
                        },
                        parameterMap: function (options) {
                            return `models=${kendo.stringify(options)}`;
                        }
                    },
                    schema: {
                        data: "data",
                        total: "totalRecords",
                        page: "page",
                        pageSize: "pageSize"
                    },
                    serverFiltering: true
                }
            });

            $('#btnTarikh').MdPersianDateTimePicker({
                targetTextSelector: '#Date',
                dateFormat: 'yyyy-MM-dd',
                dateFormat: 'yyyy-MM-dd',
                isGregorian: false,
                enableTimePicker: false,
                disableBeforeToday: false,
                modalMode: true,
                inLine: false
            });

            $("#SenatorId").kendoDropDownList({
                dataTextField: "name",
                dataValueField: "id",
                filter: "contains",
                template: "<span>#:data.name# -  #:data.hozeCityName#</span>",
                optionLabel: "یک آیتم انتخاب کنید...",
                dataSource: {
                    transport: {
                        read: {
                            dataType: "json",
                            contentType: 'application/json; charset=utf-8',
                            url: '@Url.Action("GetSenatorsForDropDown", SenatorController.CONTROLLER)',
                        },
                        parameterMap: function (options) {
                            return `models=${kendo.stringify(options)}`;
                        }
                    },
                    schema: {
                        data: "data",
                        total: "totalRecords",
                        page: "page",
                        pageSize: "pageSize"
                    },
                    serverFiltering: true
                }
            });

            $("#MolaghatTypeInt").kendoDropDownList({
                dataTextField: "name",
                dataValueField: "id",
                optionLabel: "یک آیتم انتخاب کنید...",
                dataSource: {
                    transport: {
                        read: {
                            dataType: "json",
                            contentType: 'application/json; charset=utf-8',
                            url: '@Url.Action("GetMolaghatTypesForDropDown", MolaghatController.CONTROLLER)',
                        },
                    },
                    serverFiltering: false
                }
            });


            $("#MahalInt").kendoDropDownList({
                dataTextField: "name",
                dataValueField: "id",
                optionLabel: "یک آیتم انتخاب کنید...",
                dataSource: {
                    transport: {
                        read: {
                            dataType: "json",
                            contentType: 'application/json; charset=utf-8',
                            url: '@Url.Action("GetMolaghatLocationsForDropDown", MolaghatController.CONTROLLER)',
                        },
                    },
                    serverFiltering: false
                }
            });
        });

        </script>
}