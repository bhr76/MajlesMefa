@using MajlesMefa.Back.Enums;
@using MajlesMefa.Back.Services.Abstractioin;
@using MajlesMefa.UI.Views.Report;
@model Guid?
@{
    ViewData["Title"] = "گزارش تسهیلات";
    var user = Context.RequestServices.GetService<ICurrentUserService>();
    var role = user.GetCurrentUser().Roles.FirstOrDefault();
}

<div class="home-page">
    <div class="m-portlet">
        <div class="m-portlet__body">

            <div class="row mb-3">
                <div class="col-md-3">
                    <label for="yearFilter">سال</label>
                    <select id="yearFilter" class="form-control">
                        <option value="1404">1404</option>
                        <option value="1405" selected>1405</option>
                    </select>
                </div>
            </div>

            <div class="k-rtl">
                <div id="loan-report-grid"></div>
            </div>
        </div>
    </div>
</div>

@section scripts {
    <script asp-append-version="true">
        var url_get_loan_report = '@Url.Action(nameof(LoanReportController.GetLoanReport), LoanReportController.CONTROLLER)';
        var url_response_status_dropdown = '@Url.Action(nameof(LoanReportController.GetResponseStatusForDropDown), LoanReportController.CONTROLLER)';

        $(document).ready(function () {

            var grid = $("#loan-report-grid").kendoGrid({
                dataSource: {
                    transport: {
                        read: {
                            url: url_get_loan_report,
                            type: "POST",
                            contentType: "application/json",
                            data: function () {
                                var selectedYear = $("#yearFilter").val();

                                var requestModel = {
                                    Filter: {
                                        skip: this.skip,
                                        take: this.pageSize,
                                        page: this.page,
                                        pageSize: this.pageSize,
                                        sort: this.sort
                                    },
                                    Year: selectedYear ? parseInt(selectedYear) : null
                                };

                                return requestModel;
                            }
                        },
                        parameterMap: function (data, operation) {
                            if (operation === "read") {
                                return kendo.stringify(data);
                            }
                            return data;
                        }
                    },
                    schema: {
                        data: "data",
                        total: "total",
                        model: {
                            id: "id",
                            fields: {
                                "myData.bankFullName": { type: "string" },
                                "myData.loanType": { type: "number" },
                                "myData.totalAmount": { type: "number" },
                                "myData.totalCount": { type: "number" },
                                "myData.paidAmount": { type: "number" },
                                "myData.paidCount": { type: "number" },
                                "myData.unPaidAmount": { type: "number" },
                                "myData.unPaidCount": { type: "number" },
                                "myData.inBranchAmount": { type: "number" },
                                "myData.inBranchCount": { type: "number" },
                            }
                        }
                    },
                    pageSize: 20,
                    serverPaging: true,
                    serverFiltering: false,
                    serverSorting: true
                },
                height: 550,
                sortable: true,
                pageable: {
                    refresh: true,
                    pageSizes: [10, 20, 50, 100],
                    buttonCount: 5
                },
                excel: {
                    fileName: "گزارش_تسهیلات.xlsx",
                    filterable: true,
                    allPages: true
                },
                excelExport: function (e) {
                    var sheet = e.workbook.sheets[0];

                    sheet.title = "گزارش تسهیلات";
                    sheet.rtl = true;

                    for (var rowIndex = 1; rowIndex < sheet.rows.length; rowIndex++) {
                        var row = sheet.rows[rowIndex];
                        for (var cellIndex = 0; cellIndex < row.cells.length; cellIndex++) {
                            var cell = row.cells[cellIndex];

                            if (cellIndex === 2 && rowIndex > 0) {
                                if (cell.value) {
                                    cell.format = "#,##0";
                                }
                            }

                            if (cellIndex === 3 && rowIndex > 0) {
                                if (cell.value) {
                                    cell.format = "#,##0";
                                }
                            }
                        }
                    }
                },
                toolbar: ["excel"],
                columns: [
                    {
                        field: "myData.bankFullName",
                        title: "نام بانک",
                        width: "200px",
                        template: function (dataItem) {
                            return dataItem.myData.bankFullName;
                        }
                    },
                    {
                        field: "myData.loanType",
                        title: "نوع تسهیلات",
                        width: "150px",
                        template: function (dataItem) {
                            var loanTypeText = "";
                            switch (dataItem.myData.loanType) {
                                case 1: loanTypeText = "قرض الحسنه"; break;
                                case 2: loanTypeText = "مرابحه"; break;
                                default: loanTypeText = "نامشخص";
                            }
                            return loanTypeText;
                        }
                    },
                    {
                        field: "myData.totalAmount",
                        title: "مبلغ کل (تومان)",
                        width: "150px",
                        template: function (dataItem) {
                            return dataItem.myData.totalAmount ? kendo.toString(dataItem.myData.totalAmount, "n0") : "0";
                        }
                    },
                    {
                        field: "myData.totalCount",
                        title: "تعداد کل",
                        width: "100px",
                        template: function (dataItem) {
                            return dataItem.myData.totalCount ? kendo.toString(dataItem.myData.totalCount, "n0") : "0";
                        }
                    },
                    {
                        field: "myData.paidAmount",
                        title: "مبلغ کل پرداخت شده(تومان)",
                        width: "150px",
                        template: function (dataItem) {
                            return dataItem.myData.paidAmount ? kendo.toString(dataItem.myData.paidAmount, "n0") : "0";
                        }
                    },
                    {
                        field: "myData.paidCount",
                        title: "تعداد پرداخت شده",
                        width: "100px",
                        template: function (dataItem) {
                            return dataItem.myData.paidCount ? kendo.toString(dataItem.myData.paidCount, "n0") : "0";
                        }
                    },
                    {
                        field: "myData.unPaidAmount",
                        title: "مبلغ کل رد شده (تومان)",
                        width: "150px",
                        template: function (dataItem) {
                            return dataItem.myData.unPaidAmount ? kendo.toString(dataItem.myData.unPaidAmount, "n0") : "0";
                        }
                    },
                    {
                        field: "myData.unPaidCount",
                        title: "تعداد رد شده",
                        width: "100px",
                        template: function (dataItem) {
                            return dataItem.myData.unPaidCount ? kendo.toString(dataItem.myData.unPaidCount, "n0") : "0";
                        }
                    },
                    {
                        field: "myData.inBranchAmount",
                        title: "مبلغ کل تسهیلات ارسالی به شعبه (تومان)",
                        width: "150px",
                        template: function (dataItem) {
                            return dataItem.myData.inBranchAmount ? kendo.toString(dataItem.myData.inBranchAmount, "n0") : "0";
                        }
                    },
                    {
                        field: "myData.inBranchCount",
                        title: "تعداد تسهیلات ارسالی به شعبه شعبه",
                        width: "100px",
                        template: function (dataItem) {
                            return dataItem.myData.inBranchCount ? kendo.toString(dataItem.myData.inBranchCount, "n0") : "0";
                        }
                    }
                ]
            }).data("kendoGrid");

            $("#yearFilter").change(function () {
                grid.dataSource.page(1);
            });

            $("#exportBtn").click(function () {
                grid.saveAsExcel();
            });
        });
    </script>
}
