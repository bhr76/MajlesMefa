@using MajlesMefa.UI.Views.Category;
@using MajlesMefa.UI.Views.Ezharat;
@using MajlesMefa.UI.Models;
@using MajlesMefa.UI.Views.Senator;
@{
    ViewData["Title"] = "ایجاد اظهارات";
}
@model EzharatVm

<div class="m-portlet">
    <div class="m-portlet__body">
        <form asp-controller=@EzharatController.CONTROLLER asp-action="Create" id="createMokatebeForm" method="post">
            <div class="row">
                <div asp-validation-summary="ModelOnly"></div>

                <div class="form-group mt-3 col-md-4">
                    <label asp-for="@Model.SenatorId"></label>
                    <input asp-for="@Model.SenatorId" id="SenatorId" class="form-control" />
                    <span asp-validation-for="@Model.SenatorId" class="text-danger"></span>
                </div>

                <div class="form-group mt-3 col-md-4">
                    <label asp-for="@Model.Title"></label>
                    <input asp-for="@Model.Title" id="Title" class="form-control" />
                    <span asp-validation-for="@Model.Title" class="text-danger"></span>
                </div>

                <div class="form-group mt-3 col-md-4">
                    <label asp-for="@Model.EzharatData.Manba"></label>
                    <input asp-for="@Model.EzharatData.Manba" id="Manba" class="form-control" />
                    <span asp-validation-for="@Model.EzharatData.Manba" class="text-danger"></span>
                </div>

                <div class="form-group mt-3 col-md-4">
                    <label asp-for="@Model.Date" class="control-label"></label>
                    <div class="input-group">
                        <div class="input-group-prepend">
                            <span class="input-group-text cursor-pointer" id="btnTarikh"><i class="far fa-calendar-alt"></i></span>
                        </div>
                        <input asp-for="@Model.Date" class="form-control" />
                    </div>
                    <span class="help-block"><span asp-validation-for="@Model.Date" class="text-danger"></span></span>
                </div>

                <div class="form-group col-12 mt-4">
                    <input asp-for="@Model.Moshtarak" id="Moshtarak" />
                    <label asp-for="@Model.Moshtarak">معاونت مشترک دارد</label>
                </div>

                <div id="category" class="col-12 row">
                    <div class="form-group mt-3 col-md-4">
                        <label asp-for="@Model.CategoryParentId"></label>
                        <input asp-for="@Model.CategoryParentId" id="CategoryParentId" class="form-control" />
                    </div>
                    <div class="form-group mt-3 col-md-4">
                        <label asp-for="@Model.CategoryId"></label>
                        <input asp-for="@Model.CategoryId" id="CategoryId" class="form-control" />
                        <span asp-validation-for="@Model.CategoryId" class="text-danger"></span>
                    </div>
                </div>


                <div class="form-group mt-3 col-md-12" id="moavenats">
                    <label asp-for="@Model.Moavenats"></label>
                    <select class="form-control" asp-for="@Model.Moavenats" id="Moavenats" multiple="multiple">
                    </select>
                    <span asp-validation-for="@Model.Moavenats" class="text-danger"></span>
                </div>


                <div class="form-group mt-3 col-md-12">
                    <label asp-for="@Model.Description"></label>
                    <textarea asp-for="@Model.Description" id="Description" class="form-control" rows="4"></textarea>
                    <span asp-validation-for="@Model.Description" class="text-danger"></span>
                </div>

            </div>
            <div class="row">
                <div class="submit-btn col-md-3 m-auto">
                    <input type="submit" value="ثبت" />
                </div>
            </div>

        </form>
    </div>
</div>
@section scripts{
    <script>
        $(document).ready(function () {
            $("#moavenats").hide();
            $("#category").show();

            $("#Moshtarak").change(function (event) {
                $("#moavenats").toggle();
                $("#category").toggle();
                $("#Moavenats").removeAttr('value');
                $("#CategoryParentId").removeAttr('value');
            });

            $("#Moavenats").kendoMultiSelect({
                includeSelectAllOption: true,
                dataTextField: "name",
                dataValueField: "id",
                filter: "contains",
                optionLabel: "یک آیتم انتخاب کنید...",
                dataSource: {
                    transport: {
                        read: {
                            dataType: "json",
                            contentType: 'application/json; charset=utf-8',
                            url: '@Url.Action("GetCategoriesForMultiSelect", CategoryController.CONTROLLER)',
                        },
                    },
                    schema: {
                        data: "data",
                        total: "totalRecords",
                        page: "page",
                        pageSize: "pageSize"
                    },
                    serverFiltering: false
                }
            });

            $('#btnTarikh').MdPersianDateTimePicker({
                targetTextSelector: '#Date',
                dateFormat: 'yyyy-MM-dd',
                dateFormat: 'yyyy-MM-dd',
                isGregorian: false,
                enableTimePicker: false,
                disableBeforeToday: false,
                modalMode: true,
                inLine: false
            });


            $("#SenatorId").kendoDropDownList({
                dataTextField: "name",
                dataValueField: "id",
                filter: "contains",
                template: "<span>#:data.name# -  #:data.hozeCityName#</span>",
                optionLabel: "یک آیتم انتخاب کنید...",
                dataSource: {
                    transport: {
                        read: {
                            dataType: "json",
                            contentType: 'application/json; charset=utf-8',
                            url: '@Url.Action("GetSenatorsForDropDown", SenatorController.CONTROLLER)',
                        },
                        parameterMap: function (options) {
                            return `models=${kendo.stringify(options)}`;
                        }
                    },
                    schema: {
                        data: "data",
                        total: "totalRecords",
                        page: "page",
                        pageSize: "pageSize"
                    },
                    serverFiltering: true
                }
            });

            $("#CategoryParentId").kendoDropDownList({
                dataTextField: "name",
                dataValueField: "id",
                filter: "contains",
                optionLabel: "یک آیتم انتخاب کنید...",
                dataSource: {
                    transport: {
                        read: {
                            dataType: "json",
                            contentType: 'application/json; charset=utf-8',
                            url: '@Url.Action("GetCategoriesForDropDown", CategoryController.CONTROLLER)',
                        },
                        parameterMap: function (options) {
                            return `models=${kendo.stringify(options)}`;
                        }
                    },
                    schema: {
                        data: "data",
                        total: "totalRecords",
                        page: "page",
                        pageSize: "pageSize"
                    },
                    serverFiltering: true
                }
            });

            $("#CategoryId").kendoDropDownList({
                dataTextField: "name",
                dataValueField: "id",
                filter: "contains",
                optionLabel: "یک آیتم انتخاب کنید...",
                dataSource: {}
            });

            $("#CategoryParentId").change(
                function () {
                    if ($("#CategoryParentId").val()) {
                        var parentId = $("#CategoryParentId").val();
                        $("#CategoryId").kendoDropDownList({
                            dataTextField: "name",
                            dataValueField: "id",
                            filter: "contains",
                            optionLabel: "یک آیتم انتخاب کنید...",
                            dataSource: {
                                transport: {
                                    read: {
                                        dataType: "json",
                                        contentType: 'application/json; charset=utf-8',
                                        url: '@Url.Action("GetCategoriesForDropDown", CategoryController.CONTROLLER)',
                                    },
                                    parameterMap: function (options) {
                                        return `models=${kendo.stringify(options)}&parentId=${parentId}`;
                                    }
                                },
                                schema: {
                                    data: "data",
                                    total: "totalRecords",
                                    page: "page",
                                    pageSize: "pageSize"
                                },
                                serverFiltering: true
                            }
                        });
                    } else {
                        $("#CategoryId").kendoDropDownList({
                            dataTextField: "name",
                            dataValueField: "id",
                            filter: "contains",
                            optionLabel: "یک آیتم انتخاب کنید...",
                            dataSource: {}
                        });
                    }
                })

            $("#CategoryId").change(
                function () {
                    var id = $("#CategoryId").val();
                    if (id != "") {
                        $.ajax({
                            url: "@Url.Action("GetCategoryById", CategoryController.CONTROLLER)",
                            type: "POST",
                            data: { categoryId: id },
                            dataType: "json",
                            success: function (response) {
                                if (response.hasAmount) {
                                    $("#Amount").show();
                                } else {
                                    $("#Amount").hide();
                                    $("#amount-input").val('');
                                }
                            }
                        });
                    } else {
                        $("#Amount").hide();
                        $("#amount-input").val('');
                    }
                }
            );

        });

    </script>
}