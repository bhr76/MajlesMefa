@using MajlesMefa.UI.Views.Ezharat;
@using MajlesMefa.Back.Services.Abstractioin;
@using MajlesMefa.Back.Enums;
@model Guid?
@{
    ViewData["Title"] = "لیست اظهارات رسانه‌ای";
    var id = Model.HasValue ? Model : Guid.Empty;
    var user = Context.RequestServices.GetService<ICurrentUserService>();
    var role = user.GetCurrentUser().Roles.FirstOrDefault();
}

<div class="home-page">
    <div class="m-portlet__body">
        <div class="k-rtl">
            <div id="report-grid-ezharat"></div>
        </div>

    </div>
</div>

@section scripts{
    <script asp-append-version="true">
        var url_create = '';
        var url_edit = '';
        var url_delete = '';
        var url_get_ezharat = '';
        var fromReportPage = false;
        {
            if ('@id' == null || '@id' == @Guid.Empty) { url_get_ezharat = '@Url.Action(nameof(EzharatController.GetEzharat), EzharatController.CONTROLLER)'; }
            else {
                url_get_ezharat = '@Url.Action(nameof(EzharatController.GetEzharat), EzharatController.CONTROLLER)' + '?senatorId=@id';
            }
            if (@RoleTypeEnum.Admin.Equals(role).ToString().ToLower() || @RoleTypeEnum.MinistryAdmin.Equals(role).ToString().ToLower() || @RoleTypeEnum.MinistryMember.Equals(role).ToString().ToLower() || @RoleTypeEnum.Organization.Equals(role).ToString().ToLower()) {
                url_create = '@Url.Action(nameof(EzharatController.Create), EzharatController.CONTROLLER)';
                url_edit = '@Url.Action(nameof(EzharatController.Edit), EzharatController.CONTROLLER)';
                url_delete = '@Url.Action(nameof(EzharatController.Delete), EzharatController.CONTROLLER)';
            }
        };
        var url_details = '@Url.Action(nameof(EzharatController.Details), EzharatController.CONTROLLER)';
        var btns = `<button class="k-button" data-link="${url_details}/?ezharatId=#:id#">جزییات</button>
                                                                                   #if('${url_delete}' != ''){#<button class="k-button mt-1" data-link="${url_delete}/?ezharatId=#:id#"> حذف </button>#}#
                                                                                            #if('${url_edit}' != ''){# <a class="k-button mt-1" href="${url_edit}?ezharatId=#:id#"><span class="k-icon k-i-edit"></span> ویرایش</a>#}#
                `;
      
    </script>
    <script src="~/js/pages/ezharat.js" asp-append-version="true"></script>
   
}

