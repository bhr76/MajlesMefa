@using MajlesMefa.Back.Enums;
@using MajlesMefa.UI.Views.Mokatebe;
@using MajlesMefa.UI.Models;
@{
    ViewData["Title"] = "جزییات اظهارات";
}
@model EzharatVm

@{
    Layout = null;
}

<style>
    .flex {
        display: flex;
    }

    th {
        max-width: 25% !important;
    }
</style>

<div class="card" style="margin:10px;">
    <div class="card-header">
        <p class="mb-0">
            <b>اطلاعات کامل اظهارات</b>
        </p>
    </div>
    <div class="card-body">
        <div class="row">
            <div class="col-12">
               <table class="table table-striped" style="width:100%">
                    <tr>
                        <th style="max-width:30%;">شناسه</th>
                        <td style="min-width:70%;">@Model.EzharatData.Id</td>
                    </tr>
                    <tr>
                        <th style="max-width:30%;">نماینده مرتبط</th>
                        <td style="min-width:70%;">@Model.SenatorName</td>
                    </tr>
                    <tr>
                        <th style="max-width:30%;">حوزه انتخابی نماینده</th>
                        <td style="min-width:70%;">@Model.HozeEntekhabi</td>
                    </tr>
                    <tr>
                        <th style="max-width:30%;">استان نماینده</th>
                        <td style="min-width:70%;">@Model.SenatorCity</td>
                    </tr>
                    <tr>
                        <th style="max-width:30%;">عنوان</th>
                        <td style="min-width:70%;">@Model.Title</td>
                    </tr>
                     <tr>
                        <th style="max-width:30%;">توضیحات</th>
                        <td style="min-width:70%;">@Model.Description</td>
                    </tr>
                    <tr>
                        <th style="max-width:30%;">تاریخ </th>
                        <td style="min-width:70%;">@Model.EzharatData.JalaliTarikh</td>
                    </tr>
                    <tr>
                        <th style="max-width:30%;">منبع</th>
                        <td style="min-width:70%;">@Model.EzharatData.Manba</td>
                    </tr>
                    <tr>
                        <th style="max-width:30%;">معاونت</th>
                        @if (Model.CategoryParentName is not null)
                        {
                            <td style="min-width:70%;">
                                @Model.CategoryParentName
                            </td>
                        }
                         else
                        {
                            <td style="min-width:70%;">
                                ---
                            </td>
                        }
                    </tr>

                    <tr>
                        <th style="max-width:30%;">موضوع</th>
                        @if (Model.CategoryName is not null)
                        {
                            <td style="min-width:70%;">
                                @Model.CategoryName
                            </td>
                        }
                        else
                        {
                            <td style="min-width:70%;">
                                ---
                            </td>
                        }
                    </tr>

                    </table>
            </div>
        </div>
    </div>

    <div class="card-footer">
        <h5 class="mb-0" style="text-align:left">

            

        </h5>
    </div>
</div>

