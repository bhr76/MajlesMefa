@using MajlesMefa.UI.Views.Commission;
@using MajlesMefa.UI.Models;
@{
    ViewData["Title"] = "ویرایش دستور جلسه کمیسیون";
}
@model CommissionVm

<div class="m-portlet">
    <div class="m-portlet__body">
        <form asp-controller=@CommissionController.CONTROLLER asp-action="Edit" id="EditMokatebeForm" method="post">
            <div class="row">
                <div asp-validation-summary="ModelOnly"></div>
                <input asp-for="@Model.CommissionData.Id" hidden />

                <div class="form-group mt-3 col-md-4">
                    <label asp-for="@Model.Title"></label>
                    <input asp-for="@Model.Title" id="Title" class="form-control" />
                    <span asp-validation-for="@Model.Title" class="text-danger"></span>
                </div>

                <div class="form-group mt-3 col-md-4">
                    <label asp-for="@Model.Date" class="control-label"></label>
                    <div class="input-group">
                        <div class="input-group-prepend">
                            <span class="input-group-text cursor-pointer" id="btnTarikh"><i class="far fa-calendar-alt"></i></span>
                        </div>
                        <input asp-for="@Model.Date" class="form-control" />
                    </div>
                    <span class="help-block"><span asp-validation-for="@Model.Date" class="text-danger"></span></span>
                </div>

                <div class="form-group mt-3 col-md-6">
                    <label asp-for="@Model.Description"></label>
                    <textarea asp-for="@Model.Description" id="Description" class="form-control" rows="4"></textarea>
                    <span asp-validation-for="@Model.Description" class="text-danger"></span>
                </div>


                <div class="form-group mt-3 col-md-6">
                    <label asp-for="@Model.CommissionData.Ghozareshat"></label>
                    <textarea placeholder="گزارش جلسات توسط معاونت‌ها/اسامی افراد شرکت کننده" rows="4" asp-for="@Model.CommissionData.Ghozareshat" id="Ghozareshat" class="form-control"></textarea>
                    <span asp-validation-for="@Model.CommissionData.Ghozareshat" class="text-danger"></span>
                </div>


            </div>
            <div class="row">
                <div class="submit-btn col-md-3 m-auto">
                    <input type="submit" value="ثبت" />
                </div>
            </div>

        </form>
    </div>
</div>
@section scripts{
        <script>
            $(document).ready(function () {
            $('#btnTarikh').MdPersianDateTimePicker({
                targetTextSelector: '#Date',
                dateFormat: 'yyyy-MM-dd',
                dateFormat: 'yyyy-MM-dd',
                isGregorian: false,
                enableTimePicker: false,
                disableBeforeToday: false,
                modalMode: true,
                inLine: false
            });

        });

        </script>
}