@using MajlesMefa.UI.Views.Category;
@using MajlesMefa.UI.Views.Loan;
@using MajlesMefa.UI.Models;
@using MajlesMefa.UI.Views.Organization;
@using MajlesMefa.UI.Views.Senator;
@{
    ViewData["Title"] = "تغییر وضعیت تسهیلات";

    var isSenator = ViewBag.IsSenator;
}
@model LoanVm

<div class="m-portlet">
    <div class="m-portlet__body">
        <form asp-controller=@LoanController.CONTROLLER asp-action="Edit" id="editLoanForm" method="post">
            @if (isSenator)
            {
                <h5 class="text-warning">لطفا توجه فرمایید که : کد ملی و موبایل متقاضی قابل ویرایش نیست.</h5>
            }
            <div class="row">
                <div asp-validation-summary="ModelOnly"></div>
                <input asp-for="@Model.LoanData.Id" hidden />
                @if (!isSenator)
                {
                    <div class="form-group mt-3 col-md-4">
                        <label asp-for="@Model.SenatorId"></label>
                        <input asp-for="@Model.SenatorId" id="SenatorId" readonly class="form-control" />
                    </div>

                    <div class="form-group mt-3 col-md-4">
                        <label asp-for="@Model.LoanData.FullName" class="control-label"></label>
                        <input readonly asp-for="@Model.LoanData.FullName" maxlength="256" id="FullName" class="form-control" />
                        <span asp-validation-for="@Model.LoanData.FullName" class="text-danger"></span>
                    </div>
                    <div class="form-group mt-3 col-md-4">
                        <label asp-for="@Model.LoanData.NationalNo" class="control-label"></label>
                        <input readonly asp-for="@Model.LoanData.NationalNo" maxlength="10" id="NationalNo" class="form-control" />
                        <span asp-validation-for="@Model.LoanData.NationalNo" class="text-danger"></span>
                    </div>

                    <div class="form-group mt-3 col-md-4">
                        <label asp-for="@Model.LoanData.MobileNo" class="control-label"></label>
                        <input readonly asp-for="@Model.LoanData.MobileNo" id="MobileNo" class="form-control" />
                        <span asp-validation-for="@Model.LoanData.MobileNo" class="text-danger"></span>
                    </div>

                    <div class="form-group mt-3 col-md-4">
                        <label asp-for="@Model.LoanData.LoanType"></label>
                        <input readonly asp-for="@Model.LoanData.LoanTypeInt" id="LoanType" class="form-control" />
                        <span asp-validation-for="@Model.LoanData.LoanTypeInt" class="text-danger"></span>
                    </div>

                    <div class="form-group mt-3 col-md-4">
                        <label asp-for="@Model.LoanData.Amount" class="control-label"></label>
                        <input readonly asp-for="@Model.LoanData.Amount" maxlength="15" id="Amount" class="form-control" />
                        <span asp-validation-for="@Model.LoanData.Amount" class="text-danger"></span>
                    </div>

                    <!-- ✅ فیلدهای آدرس برای غیر نماینده (فقط نمایش) -->
                    <div class="col-12 mt-4">
                        <h5>آدرس محل سکونت</h5>
                    </div>

                    <div class="form-group mt-3 col-md-4">
                        <label class="control-label">استان</label>
                        <input readonly id="ProvinceReadonly" class="form-control" />
                    </div>

                    <div class="form-group mt-3 col-md-4">
                        <label class="control-label">شهر</label>
                        <input readonly id="CityReadonly" class="form-control" />
                    </div>

                    <div class="form-group mt-3 col-md-12">
                        <label asp-for="@Model.LoanData.Address" class="control-label">آدرس کامل</label>
                        <textarea readonly asp-for="@Model.LoanData.Address" class="form-control" rows="3"></textarea>
                    </div>

                    <div class="form-group mt-3 col-md-12">
                        <label asp-for="@Model.Description"></label>
                        <textarea readonly asp-for="@Model.Description" id="Description" class="form-control" rows="4"></textarea>
                        <span asp-validation-for="@Model.Description" class="text-danger"></span>
                    </div>

                    <hr />

                    <div class="form-group mt-3 col-md-4">
                        <label asp-for="@Model.LoanData.PasokhStateInt"></label>
                        <input asp-for="@Model.LoanData.PasokhStateInt" id="PasokhState" class="form-control">
                        <span asp-validation-for="@Model.LoanData.PasokhStateInt" class="text-danger"></span>
                    </div>
                }
                else
                {

                    <div class="form-group mt-3 col-md-4">
                        <label asp-for="@Model.SenatorId"></label>
                        <input readonly asp-for="@Model.SenatorId" id="SenatorId" class="form-control" />
                    </div>

                    <div class="form-group mt-3 col-md-4">
                        <label asp-for="@Model.LoanData.FullName" class="control-label"></label>
                        <input asp-for="@Model.LoanData.FullName" maxlength="256" id="FullName" class="form-control" />
                        <span asp-validation-for="@Model.LoanData.FullName" class="text-danger"></span>
                    </div>
                    <div class="form-group mt-3 col-md-4">
                        <label asp-for="@Model.LoanData.NationalNo" class="control-label"></label>
                        <input asp-for="@Model.LoanData.NationalNo" readonly maxlength="10" id="NationalNo" class="form-control" />
                        <span asp-validation-for="@Model.LoanData.NationalNo" class="text-danger"></span>
                    </div>

                    <div class="form-group mt-3 col-md-4">
                        <label asp-for="@Model.LoanData.MobileNo" class="control-label"></label>
                        <input asp-for="@Model.LoanData.MobileNo" readonly id="MobileNo" class="form-control" />
                        <span asp-validation-for="@Model.LoanData.MobileNo" class="text-danger"></span>
                    </div>

                    <div class="form-group mt-3 col-md-4">
                        <label asp-for="@Model.LoanData.LoanType"></label>
                        <input asp-for="@Model.LoanData.LoanTypeInt" id="LoanType" class="form-control" />
                        <span asp-validation-for="@Model.LoanData.LoanTypeInt" class="text-danger"></span>
                    </div>

                    <div class="form-group mt-3 col-md-4">
                        <label asp-for="@Model.LoanData.Amount" class="control-label"></label>
                        <input asp-for="@Model.LoanData.Amount" maxlength="15" id="Amount" class="form-control" />
                        <span asp-validation-for="@Model.LoanData.Amount" class="text-danger"></span>
                    </div>

                    <!-- ✅ فیلدهای آدرس برای نماینده (قابل ویرایش) -->
                    <div class="col-12 mt-4">
                        <h5>آدرس محل سکونت</h5>
                    </div>

                    <div class="form-group mt-3 col-md-4">
                        <label asp-for="@Model.LoanData.ProvinceId" class="control-label">استان</label>
                        <select asp-for="@Model.LoanData.ProvinceId" id="ProvinceId" class="form-control">
                            <option value="">انتخاب کنید...</option>
                        </select>
                        <span asp-validation-for="@Model.LoanData.ProvinceId" class="text-danger"></span>
                    </div>

                    <div class="form-group mt-3 col-md-4">
                        <label asp-for="@Model.LoanData.CityId" class="control-label">شهر</label>
                        <select asp-for="@Model.LoanData.CityId" id="CityId" class="form-control" disabled>
                            <option value="">ابتدا استان را انتخاب کنید...</option>
                        </select>
                        <span asp-validation-for="@Model.LoanData.CityId" class="text-danger"></span>
                    </div>

                    <div class="form-group mt-3 col-md-12">
                        <label asp-for="@Model.LoanData.Address" class="control-label">آدرس کامل</label>
                        <textarea asp-for="@Model.LoanData.Address" id="Address" class="form-control" rows="3" placeholder="آدرس دقیق محل سکونت خود را وارد کنید..."></textarea>
                        <span asp-validation-for="@Model.LoanData.Address" class="text-danger"></span>
                    </div>

                    <div class="form-group mt-3 col-md-12">
                        <label asp-for="@Model.Description"></label>
                        <textarea asp-for="@Model.Description" id="Description" class="form-control" rows="4"></textarea>
                        <span asp-validation-for="@Model.Description" class="text-danger"></span>
                    </div>
                }

            </div>
            <div class="row">
                <div class="submit-btn col-md-3 m-auto">
                    <input id="submitBtn" type="button" value="ثبت" />
                </div>
            </div>

        </form>
    </div>
</div>

@section scripts {
    <script>
        $(document).ready(function () {

            $("#PasokhState").kendoDropDownList({
                dataTextField: "name",
                dataValueField: "id",
                optionLabel: "یک آیتم انتخاب کنید...",
                dataSource: {
                    transport: {
                        read: {
                            dataType: "json",
                            contentType: 'application/json; charset=utf-8',
                            url: '@Url.Action("GetPasokhStatesForDropDown", LoanController.CONTROLLER)',
                        },
                    },
                    serverFiltering: false
                }
            });

            $("#LoanType").kendoDropDownList({
                dataTextField: "name",
                dataValueField: "id",
                optionLabel: "یک آیتم انتخاب کنید...",
                dataSource: {
                    transport: {
                        read: {
                            dataType: "json",
                            contentType: 'application/json; charset=utf-8',
                            url: '@Url.Action("GetLoanTypesForDropDown", LoanController.CONTROLLER)',
                        },
                    },
                    serverFiltering: false
                }
            });

            $("#SenatorId").kendoDropDownList({
                dataTextField: "name",
                dataValueField: "id",
                filter: "contains",
                template: "<span>#:data.name# -  #:data.hozeCityName#</span>",
                optionLabel: "یک آیتم انتخاب کنید...",
                dataSource: {
                    transport: {
                        read: {
                            dataType: "json",
                            contentType: 'application/json; charset=utf-8',
                            url: '@Url.Action("GetSenatorsForDropDown", SenatorController.CONTROLLER)',
                        },
                        parameterMap: function (options) {
                            return `models=${kendo.stringify(options)}`;
                        }
                    },
                    schema: {
                        data: "data",
                        total: "totalRecords",
                        page: "page",
                        pageSize: "pageSize"
                    },
                    serverFiltering: true,
                    filter: function (item) {
                        if (this.filterSource && this.filterSource.filter && this.filterSource.filter.filters.length > 0) {
                            var filter = this.filterSource.filter.filters[0];
                            var searchText = filter.value.toLowerCase();

                            return item.name.toLowerCase().indexOf(searchText) >= 0 ||
                                item.hozeCityName.toLowerCase().indexOf(searchText) >= 0;
                        }
                        return true;
                    }
                },
                filtering: function (e) {
                    var filterValue = e.filter ? e.filter.value : "";

                    if (this.dataSource.options.serverFiltering) {
                        e.preventDefault();

                        var filter = {
                            logic: "or",
                            filters: [
                                { field: "name", operator: "contains", value: filterValue },
                                { field: "hozeCityName", operator: "contains", value: filterValue }
                            ]
                        };

                        this.dataSource.filter(filter);
                    }
                }
            });

            // ✅ فقط برای نماینده: تنظیم دراپ‌داون‌های استان و شهر
            @if (isSenator)
            {
                    <text>
                    // ============ Province DropDown ============
                    var provinceDropDown = $("#ProvinceId").kendoDropDownList({
                        dataTextField: "name",
                        dataValueField: "id",
                        optionLabel: "انتخاب کنید...",
                        dataSource: {
                            transport: {
                                read: {
                                    dataType: "json",
                                    contentType: 'application/json; charset=utf-8',
                                    type: 'POST',
                                    url: '@Url.Action("GetProvincesForDropDown", LoanController.CONTROLLER)',
                                }
                            },
                            schema: {
                                parse: function(response) {
                                    return response.data;
                                }
                            }
                        },
                        change: function(e) {
                            var selectedValue = this.value();

                            if (selectedValue) {
                                var cityDropDown = $("#CityId").data("kendoDropDownList");
                                cityDropDown.enable(true);
                                loadCities(selectedValue);
                            } else {
                                var cityDropDown = $("#CityId").data("kendoDropDownList");
                                cityDropDown.enable(false);
                                cityDropDown.value("");
                                cityDropDown.setDataSource([]);
                            }
                        }
                    }).data("kendoDropDownList");

                    // ============ City DropDown ============
                    var cityDropDown = $("#CityId").kendoDropDownList({
                        dataTextField: "name",
                        dataValueField: "id",
                        optionLabel: "ابتدا استان را انتخاب کنید...",
                        enable: false,
                        dataSource: {
                            data: []
                        }
                    }).data("kendoDropDownList");

                    // ============ تابع بارگذاری شهرها ============
                    function loadCities(provinceId) {
                        if (!provinceId) return;

                        var cityDropDown = $("#CityId").data("kendoDropDownList");
                        cityDropDown.text("در حال بارگذاری...");
                        cityDropDown.enable(false);

                        $.ajax({
                            url: '@Url.Action("GetCitiesByProvinceForDropDown", LoanController.CONTROLLER)',
                            type: 'POST',
                            data: { provinceId: provinceId },
                            dataType: 'json',
                            success: function(response) {
                                if (response.data && response.data.length > 0) {
                                    cityDropDown.setDataSource(new kendo.data.DataSource({
                                        data: response.data
                                    }));

                                    cityDropDown.enable(true);
                                    cityDropDown.value("");

                                    // تنظیم شهر در حالت Edit
                                    @if (Model.LoanData?.CityId != null)
                                    {
                                            <text>
                                            var cityId = '@Model.LoanData.CityId';
                                            setTimeout(function() {
                                                cityDropDown.value(cityId);
                                            }, 100);
                                            </text>
                                    }
                                } else {
                                    cityDropDown.setDataSource([]);
                                    cityDropDown.enable(false);
                                    toastr.warning('شهری برای این استان یافت نشد');
                                }
                            },
                            error: function(xhr, status, error) {
                                console.error('Error loading cities:', error);
                                cityDropDown.setDataSource([]);
                                cityDropDown.enable(false);
                                toastr.error('خطا در بارگذاری لیست شهرها');
                            }
                        });
                    }

                    // ============ Format Amount ============
                    $('#Amount').on('keyup', function () {
                        var input = $(this);
                        var value = input.val().replace(/,/g, '');

                        if (!/^\d*$/.test(value)) {
                            value = value.replace(/\D/g, '');
                        }

                        var formattedValue = value.replace(/\B(?=(\d{3})+(?!\d))/g, ",");
                        input.val(formattedValue);
                    });

                    // ============ تنظیم مقادیر Edit ============
                    @if (Model.LoanData?.ProvinceId != null)
                    {
                            <text>
                            provinceDropDown.dataSource.one("requestEnd", function() {
                                provinceDropDown.value('@Model.LoanData.ProvinceId');
                                loadCities('@Model.LoanData.ProvinceId');
                            });
                            </text>
                    }
                    </text>
            }
            else
            {
                    <text>
                    // ✅ برای غیر نماینده: نمایش نام استان و شهر
                    @if (Model.LoanData?.ProvinceId != null)
                    {
                            <text>
                            // بارگذاری نام استان
                            $.ajax({
                                url: '@Url.Action("GetProvincesForDropDown", LoanController.CONTROLLER)',
                                type: 'POST',
                                dataType: 'json',
                                success: function(response) {
                                    if (response.data) {
                                        var province = response.data.find(p => p.id === '@Model.LoanData.ProvinceId');
                                        if (province) {
                                            $('#ProvinceReadonly').val(province.name);
                                        }
                                    }
                                }
                            });

                            // بارگذاری نام شهر
                            $.ajax({
                                url: '@Url.Action("GetCitiesByProvinceForDropDown", LoanController.CONTROLLER)',
                                type: 'POST',
                                data: { provinceId: '@Model.LoanData.ProvinceId' },
                                dataType: 'json',
                                success: function(response) {
                                    if (response.data) {
                                        var city = response.data.find(c => c.id === '@Model.LoanData.CityId');
                                        if (city) {
                                            $('#CityReadonly').val(city.name);
                                        }
                                    }
                                }
                            });
                            </text>
                    }
                    </text>
            }

        });

        // رویداد کلیک دکمه ثبت با Confirm
        $("#submitBtn").click(function (e) {
            e.preventDefault();

            // اعتبارسنجی فرم
            var validator = $("#editLoanForm").kendoValidator().data('kendoValidator');

            if (validator.validate()) {
                // نمایش Confirm Dialog با Kendo
                showConfirmDialog();
            }
        });

        // تابع نمایش Confirm با Kendo UI
        function showConfirmDialog() {
            var dialog = $("<div></div>").kendoDialog({
                width: "450px",
                title: "تایید ثبت تغییرات",
                closable: false,
                content: `
                            <div style="text-align: center; padding: 20px;">
                                <i class="fas fa-question-circle" style="font-size: 48px; color: #f39c12; margin-bottom: 15px;"></i>
                                <p style="font-size: 16px; margin: 10px 0;">آیا از ثبت تغییرات اطمینان دارید؟</p>
                                <p style="font-size: 14px; color: #7f8c8d;">این عملیات غیرقابل بازگشت است.</p>
                            </div>
                        `,
                actions: [
                    {
                        text: "انصراف",
                        cssClass: "btn btn-secondary",
                        action: function () {
                            return true; // بستن دیالوگ
                        }
                    },
                    {
                        text: "تایید و ثبت",
                        cssClass: "btn btn-primary",
                        primary: true,
                        action: function () {
                            // ثبت فرم
                            $("#editLoanForm").submit();
                            return true;
                        }
                    }
                ]
            });

            dialog.data("kendoDialog").open();
        }

    </script>
}

<style>
    /* استایل سفارشی برای دیالوگ */
    .k-dialog {
        direction: rtl;
        text-align: right;
    }

    .k-dialog-buttongroup {
        display: flex;
        flex-direction: row-reverse;
        gap: 10px;
    }

    .k-dialog-title {
        text-align: center;
        font-weight: bold;
    }
</style>