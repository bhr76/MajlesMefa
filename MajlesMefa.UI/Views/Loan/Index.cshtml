@using MajlesMefa.UI.Views.Loan;
@using MajlesMefa.Back.Enums;
@using MajlesMefa.UI.Views.Peygiri;
@using MajlesMefa.UI.Views.ActionReference;
@using MajlesMefa.Back.Services.Abstractioin;
@using MajlesMefa.Back.Enums;
@model Guid?
@{
    ViewData["Title"] = "لیست تسهیلات";
    var id = Model.HasValue ? Model : Guid.Empty;
    var user = Context.RequestServices.GetService<ICurrentUserService>();
    var role = user.GetCurrentUser().Roles.FirstOrDefault();
}

<div class="home-page">
    <div class="m-portlet__body">
        <div class="k-rtl">
            <div id="report-grid-loan"></div>
        </div>

    </div>
</div>

@section scripts{
    <script asp-append-version="true">
        var userRole = '@role';
        var url_get_loan = '';
        var url_create = '';
        var url_edit = '';
        var fromReportPage = false;
        var url_delete = '';
        {
            if ('@id' == null || '@id' == @Guid.Empty) { url_get_loan = '@Url.Action(nameof(LoanController.GetLoans), LoanController.CONTROLLER)'; }
            else {
                url_get_loan = '@Url.Action(nameof(LoanController.GetLoans), LoanController.CONTROLLER)' + '?senatorId=@id';
            }
            if (@RoleTypeEnum.Admin.Equals(role).ToString().ToLower() || 
            @RoleTypeEnum.MinistryAdmin.Equals(role).ToString().ToLower() || 
            @RoleTypeEnum.MinistryMember.Equals(role).ToString().ToLower() || 
            @RoleTypeEnum.Organization.Equals(role).ToString().ToLower()) {
                url_edit = '@Url.Action(nameof(LoanController.Edit), LoanController.CONTROLLER)';
                url_delete = '@Url.Action(nameof(LoanController.Delete), LoanController.CONTROLLER)';
            }
        };
        {
            if (@RoleTypeEnum.Admin.Equals(role).ToString().ToLower() || @RoleTypeEnum.MinistryAdmin.Equals(role).ToString().ToLower() || @RoleTypeEnum.MinistryMember.Equals(role).ToString().ToLower() || @RoleTypeEnum.Organization.Equals(role).ToString().ToLower()) {
                url_edit = '@Url.Action(nameof(LoanController.Edit), LoanController.CONTROLLER)';
                url_delete = '@Url.Action(nameof(LoanController.Delete), LoanController.CONTROLLER)';
            }
        }
        url_create ='';
        {
            if(@RoleTypeEnum.Senator.Equals(role).ToString().ToLower()){
               url_create = '@Url.Action(nameof(LoanController.Create), LoanController.CONTROLLER)';

                url_edit = '@Url.Action(nameof(LoanController.Edit), LoanController.CONTROLLER)';
            }
        }
        
        
        var url_details = '@Url.Action(nameof(LoanController.Details), LoanController.CONTROLLER)';
        var url_actionReference = '@Url.Action(nameof(ActionReferenceController.Index), ActionReferenceController.CONTROLLER)' + '?dataEntryId=#:id#&dataEntryType=#:dataEntryType#';
        var url_action = '@Url.Action(nameof(ActionReferenceController.ActionIndex), ActionReferenceController.CONTROLLER)' + '?dataEntryId=#:id#&dataEntryType=#:dataEntryType#';
        var url_refrenceTo = '@Url.Action(nameof(ActionReferenceController.RefrenceTo), ActionReferenceController.CONTROLLER)' + '?dataEntryId=#:id#';
        var url_peygiri = '@Url.Action(nameof(PeygiriController.Index), PeygiriController.CONTROLLER,new{dataEntryType=DataEntryTypeEnum.Loan})';
        var url_actionTo = '@Url.Action(nameof(ActionReferenceController.ActionTo), ActionReferenceController.CONTROLLER)' + '?dataEntryId=#:id#';
        //<button class="k-button" data-link="${url_details}/?loanId=#:id#">جزییات</button>
        var btns = ` <a class="k-button mt-1" href="${url_peygiri}&dataEntryId=#:id#""></span> پیگیری ها</a>
                                                                                                                                       #if ('${userRole}' != "Senator" && '${userRole}' != "Organization") {# <button class="k-button mt-1" data-link="${url_refrenceTo}"> ارجاع به </button> #}#
                                                                                                                        #if ('${userRole}' != "Senator") {# <button class="k-button mt-1" data-link="${url_actionTo}"> اقدام </button> #}#
                                                             <a class="k-button mt-1" href="${url_actionReference}"></span> ارجاعات</a>
                                                                      <a class="k-button mt-1" href="${url_action}"></span> اقدامات</a>
                                                                     #if('${url_edit}' != ''){#<a class="k-button mt-1" href="${url_edit}?loanId=#:id#"><span class="k-icon k-i-edit"></span> ویرایش</a>#}#
                        `;

    </script>
    <script src="~/js/pages/loan.js" asp-append-version="true"></script>

}

