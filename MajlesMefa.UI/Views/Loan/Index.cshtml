@using MajlesMefa.UI.Views.Loan;
@using MajlesMefa.Back.Enums;
@using MajlesMefa.UI.Views.Peygiri;
@using MajlesMefa.UI.Views.ActionReference;
@using MajlesMefa.Back.Services.Abstractioin;
@using System.ComponentModel.DataAnnotations;
@using System.Reflection;
@model Guid?
@{
    ViewData["Title"] = "لیست ارجاعات";
    var id = Model.HasValue ? Model : Guid.Empty;
    var user = Context.RequestServices.GetService<ICurrentUserService>();
    var role = user.GetCurrentUser().Roles.FirstOrDefault();
    var username = user.GetCurrentUser().UserName;
    var canSeeBatchActions = string.Equals(username, "b.refah", StringComparison.OrdinalIgnoreCase);

    // استخراج لیست مقادیر و عنوان‌های نمایشی Enum و تبدیل به JSON
    var refTypeItems = Enum.GetValues(typeof(RefTypeEnum))
        .Cast<RefTypeEnum>()
        .Select(e =>
        {
            var field = e.GetType().GetField(e.ToString());
            var display = field?.GetCustomAttribute<DisplayAttribute>();
            return new
            {
                Value = (short)e,
                Text = display != null ? display.Name : e.ToString()
            };
        }).ToList();
    var refTypeJson = Newtonsoft.Json.JsonConvert.SerializeObject(refTypeItems);
}

<div class="home-page">
    <div class="m-portlet__body">
        <div class="m-portlet">
            <div class="m-portlet__body">
                <form>
                    <div class="row">
                        <div class=" col-md-2">
                            <label>نوع تسهیلات</label>
                            <input style="width:200px" id="LoanTypeDropDown" class="form-control" />
                        </div>

                        <div class="ml-3 col-md-2">
                            <label>وضعیت تسهیلات</label>
                            <input style="width:200px" id="PasokhStateDropDown" class="form-control" />
                        </div>

                        <div class="ml-3 col-md-2">
                            <label>سال</label>
                            <input style="width:200px" id="LoanYearDropDown" class="form-control" />
                        </div>
                    </div>
                </form>
            </div>
        </div>

        <br />

        @if (canSeeBatchActions)
        {
            <!-- بخش دکمه‌های عملیات گروهی -->
            <div id="batchActionContainer" class="mb-3 d-flex align-items-center" style="display: none !important; gap: 10px;">
                <button id="batchStatusBtn" type="button" class="k-button k-primary">
                    تغییر وضعیت گروهی (<span id="selectedCount">0</span> مورد)
                </button>
                <button id="batchRegisterActionBtn" type="button" class="k-button k-primary">
                    ثبت اقدام گروهی
                </button>
                <button id="clearSelectionBtn" type="button" class="k-button">
                    انصراف از انتخاب
                </button>
            </div>
        }

        <div id="batchStatusWindow" style="display:none;">
            <div class="p-3">
                <div class="form-group mb-3">
                    <label for="batchStatusDropDown">وضعیت جدید</label>
                    <input id="batchStatusDropDown" style="width:100%;" />
                </div>
                <div class="d-flex justify-content-end" style="gap:10px;">
                    <button id="submitBatchStatusBtn" type="button" class="k-button k-primary">ثبت</button>
                    <button id="cancelBatchStatusBtn" type="button" class="k-button">انصراف</button>
                </div>
            </div>
        </div>

        <div id="batchActionWindow" style="display:none;">
            <div class="p-3">
                <div class="form-group mb-3">
                    <label for="batchActionTypeDropDown">نوع اقدام</label>
                    <input id="batchActionTypeDropDown" style="width:100%;" />
                </div>
                <div class="form-group mb-3">
                    <label for="batchActionDescription">شرح اقدام</label>
                    <textarea id="batchActionDescription" class="k-textbox" style="width:100%; min-height:120px;"></textarea>
                </div>
                <div class="d-flex justify-content-end" style="gap:10px;">
                    <button id="submitBatchActionBtn" type="button" class="k-button k-primary">ثبت</button>
                    <button id="cancelBatchActionBtn" type="button" class="k-button">انصراف</button>
                </div>
            </div>
        </div>

        <div class="k-rtl">
            <div id="report-grid-loan"></div>
        </div>

    </div>
</div>

@section scripts {
    <script asp-append-version="true">
        // مقدار دهی منبع داده نوع اقدام جهت استفاده در loan.js
        var refTypeDataSource = @Html.Raw(refTypeJson);

             var loanYearDataSource = [
            { Text: "1404", Value: 1404 },
            { Text: "1405", Value: 1405 }
        ];
        var userRole = '@role';
        var url_get_loan = '';
        var url_create = '';
        var url_edit = '';
        var url_log = '';
        var fromReportPage = false;
        var url_delete = '';
        {
            if ('@id' == null || '@id' == @Guid.Empty) { url_get_loan = '@Url.Action(nameof(LoanController.GetLoans), LoanController.CONTROLLER)'; }
            else {
                url_get_loan = '@Url.Action(nameof(LoanController.GetLoans), LoanController.CONTROLLER)' + '?senatorId=@id';
            }
            if (@RoleTypeEnum.Admin.Equals(role).ToString().ToLower() ||
            @RoleTypeEnum.MinistryAdmin.Equals(role).ToString().ToLower() ||
            @RoleTypeEnum.MinistryMember.Equals(role).ToString().ToLower() ||
            @RoleTypeEnum.Organization.Equals(role).ToString().ToLower()) {
                url_edit = '@Url.Action(nameof(LoanController.Edit), LoanController.CONTROLLER)';
                url_delete = '@Url.Action(nameof(LoanController.Delete), LoanController.CONTROLLER)';
            }
        };
        {
            if (@RoleTypeEnum.Admin.Equals(role).ToString().ToLower() || @RoleTypeEnum.MinistryAdmin.Equals(role).ToString().ToLower() || @RoleTypeEnum.MinistryMember.Equals(role).ToString().ToLower() || @RoleTypeEnum.Organization.Equals(role).ToString().ToLower()) {
                url_edit = '@Url.Action(nameof(LoanController.Edit), LoanController.CONTROLLER)';
                url_delete = '@Url.Action(nameof(LoanController.Delete), LoanController.CONTROLLER)';
            }
        };
        url_create ='';
        {
            if(@RoleTypeEnum.Senator.Equals(role).ToString().ToLower()){
               url_create = '@Url.Action(nameof(LoanController.Create), LoanController.CONTROLLER)';

                url_edit = '@Url.Action(nameof(LoanController.Edit), LoanController.CONTROLLER)';
            }
           if ('@username' === "b.refah") {
            url_create = '@Url.Action(nameof(LoanController.AdminLoan), LoanController.CONTROLLER)';
            }
        };

        url_log = '';
        {
            if (@RoleTypeEnum.Admin.Equals(role).ToString().ToLower() || @RoleTypeEnum.MinistryAdmin.Equals(role).ToString().ToLower() || @RoleTypeEnum.MinistryMember.Equals(role).ToString().ToLower()) {
                url_log = '@Url.Action(nameof(ActionReferenceController.LogIndex), ActionReferenceController.CONTROLLER)' ;
            }

        };

        var url_details = '@Url.Action(nameof(LoanController.Details), LoanController.CONTROLLER)';
        var url_actionReference = '@Url.Action(nameof(ActionReferenceController.Index), ActionReferenceController.CONTROLLER)' + '?dataEntryId=#:id#&dataEntryType=#:dataEntryType#';
        var url_action = '@Url.Action(nameof(ActionReferenceController.ActionIndex), ActionReferenceController.CONTROLLER)' + '?dataEntryId=#:id#&dataEntryType=#:dataEntryType#';

        var url_refrenceTo = '@Url.Action(nameof(ActionReferenceController.RefrenceTo), ActionReferenceController.CONTROLLER)' + '?dataEntryId=#:id#';
        var url_peygiri = '@Url.Action(nameof(PeygiriController.Index), PeygiriController.CONTROLLER, new { dataEntryType = DataEntryTypeEnum.Loan })';
        var url_actionTo = '@Url.Action(nameof(ActionReferenceController.ActionTo), ActionReferenceController.CONTROLLER)' + '?dataEntryId=#:id#';
        var url_batch_action = '@Url.Action("BatchAction", "Loan")';
        var url_batch_change_status = '@Url.Action("BatchChangeStatus", "Loan")';
        var url_batch_register_action = '@Url.Action("BatchRegisterAction", "Loan")';
        var btns = `
            <a class="k-button mt-1" target="_blank" href="${url_peygiri}&dataEntryId=#:id#">پیگیری ها</a>

            #if ('${userRole}' != "Senator" && '${userRole}' != "Organization") {#
                <button class="k-button mt-1" data-link="${url_refrenceTo}">ارجاع به</button>
            #}#

            #if ('${userRole}' != "Senator") {#
                <button class="k-button mt-1" data-link="${url_actionTo}">اقدام</button>
            #}#

            <a class="k-button mt-1" target="_blank" href="${url_actionReference}">ارجاعات</a>
            <a class="k-button mt-1" target="_blank" href="${url_action}">اقدامات</a>

            #if('${url_log}' != ''){#
                <a class="k-button mt-1" target="_blank" href="${url_log}?dataEntryId=#:id#&dataEntryType=#:dataEntryType#">
                    تاریخچه تغییرات
                </a>
            #}#

            #if('${url_edit}' != ''){#
                <a class="k-button mt-1" target="_blank" href="${url_edit}?loanId=#:id#">
                    <span class="k-icon k-i-edit"></span> ویرایش
                </a>
            #}#
        `;
    </script>
    <script src="~/js/pages/loan.js" asp-append-version="true"></script>
}
