@using MajlesMefa.UI.Views.Category;
@using MajlesMefa.UI.Views.Loan;
@using MajlesMefa.UI.Models;
@using MajlesMefa.UI.Views.Organization;
@using MajlesMefa.UI.Views.Senator;
@{
    ViewData["Title"] = "درخواست تسهیلات";
}
@model LoanByAdminViewModel

<div class="m-portlet">
    <div class="m-portlet__body">
        <form asp-controller=@LoanController.CONTROLLER asp-action="CreateLoanByAdmin" id="createLoanForm" method="post">

            <h5 class="text-warning">لطفا توجه فرمایید که : کد ملی و موبایل متقاضی قابل ویرایش نیست و می بایست متعلق به یک شخص باشد.</h5>

            <div class="row">
                <div asp-validation-summary="ModelOnly"></div>


                <div class="form-group mt-3 col-md-4">
                    <label asp-for="@Model.SenatorId"></label>
                    <input asp-for="@Model.SenatorId" id="SenatorId" class="form-control" />
                </div>
                <div class="form-group mt-3 col-md-4">
                    <label asp-for="@Model.LoanData.PasokhStateInt"></label>
                    <input asp-for="@Model.LoanData.PasokhStateInt" id="PasokhState" class="form-control">
                    <span asp-validation-for="@Model.LoanData.PasokhStateInt" class="text-danger"></span>
                </div>
                <!-- اطلاعات شخصی -->
                <div class="col-12 mt-4">
                    <h5>اطلاعات شخصی</h5>
                </div>

                <div class="form-group mt-3 col-md-4">
                    <label asp-for="@Model.LoanData.FullName" class="control-label"></label>
                    <input asp-for="@Model.LoanData.FullName" maxlength="256" id="FullName" class="form-control" />
                    <span asp-validation-for="@Model.LoanData.FullName" class="text-danger"></span>
                </div>

                <div class="form-group mt-3 col-md-4">
                    <label asp-for="@Model.LoanData.NationalNo" class="control-label"></label>
                    <input asp-for="@Model.LoanData.NationalNo" maxlength="10" id="NationalNo" class="form-control" />
                    <span asp-validation-for="@Model.LoanData.NationalNo" class="text-danger"></span>
                </div>

                <div class="form-group mt-3 col-md-4">
                    <label asp-for="@Model.LoanData.MobileNo" class="control-label"></label>
                    <input asp-for="@Model.LoanData.MobileNo" maxlength="11" id="MobileNo" class="form-control" />
                    <span asp-validation-for="@Model.LoanData.MobileNo" class="text-danger"></span>
                </div>

                <!-- اطلاعات تسهیلات -->
                <div class="col-12 mt-4">
                    <h5>اطلاعات تسهیلات</h5>
                </div>

                <div class="form-group mt-3 col-md-4">
                    <label asp-for="@Model.LoanData.LoanType"></label>
                    <select asp-for="@Model.LoanData.LoanTypeInt" id="LoanType" class="form-control"></select>
                    <span asp-validation-for="@Model.LoanData.LoanTypeInt" class="text-danger"></span>
                </div>

                <div class="form-group mt-3 col-md-4">
                    <label asp-for="@Model.LoanData.Amount" class="control-label"></label>
                    <input inputmode="numeric" asp-for="@Model.LoanData.Amount" maxlength="15" id="Amount" class="form-control" />
                    <span asp-validation-for="@Model.LoanData.Amount" class="text-danger"></span>
                </div>

                <!-- آدرس محل سکونت -->
                <div class="col-12 mt-4">
                    <h5>آدرس محل سکونت</h5>
                </div>

                <div class="form-group mt-3 col-md-4">
                    <label asp-for="@Model.LoanData.ProvinceId" class="control-label">استان</label>
                    <select asp-for="@Model.LoanData.ProvinceId" id="ProvinceId" class="form-control">
                        <option value="">انتخاب کنید...</option>
                    </select>
                    <span asp-validation-for="@Model.LoanData.ProvinceId" class="text-danger"></span>
                </div>

                <div class="form-group mt-3 col-md-4">
                    <label asp-for="@Model.LoanData.CityId" class="control-label">شهر</label>
                    <select asp-for="@Model.LoanData.CityId" id="CityId" class="form-control" disabled>
                        <option value="">ابتدا استان را انتخاب کنید...</option>
                    </select>
                    <span asp-validation-for="@Model.LoanData.CityId" class="text-danger"></span>
                </div>

                <div class="form-group mt-3 col-md-12">
                    <label asp-for="@Model.LoanData.Address" class="control-label">آدرس کامل</label>
                    <textarea asp-for="@Model.LoanData.Address" id="Address" class="form-control" rows="3" placeholder="آدرس دقیق محل سکونت خود را وارد کنید..."></textarea>
                    <span asp-validation-for="@Model.LoanData.Address" class="text-danger"></span>
                </div>

                <!-- توضیحات -->
                <div class="col-12 mt-4">
                    <h5>توضیحات</h5>
                </div>

                <div class="form-group mt-3 col-md-12">
                    <label asp-for="@Model.Description"></label>
                    <textarea asp-for="@Model.Description" id="Description" class="form-control" rows="4"></textarea>
                    <span asp-validation-for="@Model.Description" class="text-danger"></span>
                </div>

            </div>

            <div class="row">
                <div class="submit-btn col-md-3 m-auto">
                    <input id="submitBtn" type="submit" value="ثبت" />
                </div>
            </div>

        </form>
    </div>
</div>

@section scripts {
    <script>
        $(document).ready(function () {

                  $("#PasokhState").kendoDropDownList({
                dataTextField: "name",
                dataValueField: "id",
                optionLabel: "یک آیتم انتخاب کنید...",
                dataSource: {
                    transport: {
                        read: {
                            dataType: "json",
                            contentType: 'application/json; charset=utf-8',
                            url: '@Url.Action("GetPasokhStatesForDropDown", LoanController.CONTROLLER)',
                        },
                    },
                    serverFiltering: false
                }
            });

            // ============ Loan Type DropDown ============
            $("#LoanType").kendoDropDownList({
                dataTextField: "name",
                dataValueField: "id",
                optionLabel: "یک آیتم انتخاب کنید...",
                dataSource: {
                    transport: {
                        read: {
                            dataType: "json",
                            contentType: 'application/json; charset=utf-8',
                            url: '@Url.Action("GetLoanTypesForDropDown", LoanController.CONTROLLER)',
                        },
                    },
                    serverFiltering: false
                }
            });




             $("#SenatorId").kendoDropDownList({
                dataTextField: "name",
                dataValueField: "id",
                filter: "contains",
                template: "<span>#:data.name# -  #:data.hozeCityName#</span>",
                optionLabel: "یک آیتم انتخاب کنید...",
                dataSource: {
                    transport: {
                        read: {
                            dataType: "json",
                            contentType: 'application/json; charset=utf-8',
                            url: '@Url.Action("GetSenatorsForDropDown", SenatorController.CONTROLLER)',
                        },
                        parameterMap: function (options) {
                            return `models=${kendo.stringify(options)}`;
                        }
                    },
                    schema: {
                        data: "data",
                        total: "totalRecords",
                        page: "page",
                        pageSize: "pageSize"
                    },
                    serverFiltering: true,
                    filter: function (item) {
                        if (this.filterSource && this.filterSource.filter && this.filterSource.filter.filters.length > 0) {
                            var filter = this.filterSource.filter.filters[0];
                            var searchText = filter.value.toLowerCase();

                            return item.name.toLowerCase().indexOf(searchText) >= 0 ||
                                item.hozeCityName.toLowerCase().indexOf(searchText) >= 0;
                        }
                        return true;
                    }
                },
                filtering: function (e) {
                    var filterValue = e.filter ? e.filter.value : "";

                    if (this.dataSource.options.serverFiltering) {
                        e.preventDefault();

                        var filter = {
                            logic: "or",
                            filters: [
                                { field: "name", operator: "contains", value: filterValue },
                                { field: "hozeCityName", operator: "contains", value: filterValue }
                            ]
                        };

                        this.dataSource.filter(filter);
                    }
                }
            });


            // ============ Province DropDownList ============
            var provinceDropDown = $("#ProvinceId").kendoDropDownList({
                dataTextField: "name",
                dataValueField: "id",
                optionLabel: "انتخاب کنید...",
                dataSource: {
                    transport: {
                        read: {
                            dataType: "json",
                            contentType: 'application/json; charset=utf-8',
                            type: 'POST',
                            url: '@Url.Action("GetProvincesForDropDown", LoanController.CONTROLLER)',
                        }
                    },
                    schema: {
                        parse: function(response) {
                            console.log("Province Response:", response);
                            return response.data;
                        }
                    }
                },
                dataBound: function(e) {
                    console.log("Provinces loaded:", this.dataSource.data());
                },
                change: function(e) {
                    var selectedValue = this.value();
                    console.log("Selected Province:", selectedValue);

                    if (selectedValue) {
                        var cityDropDown = $("#CityId").data("kendoDropDownList");
                        cityDropDown.enable(true);
                        loadCities(selectedValue);
                    } else {
                        var cityDropDown = $("#CityId").data("kendoDropDownList");
                        cityDropDown.enable(false);
                        cityDropDown.value("");
                        cityDropDown.setDataSource([]);
                    }
                }
            }).data("kendoDropDownList");

            // ============ City DropDownList ============
            var cityDropDown = $("#CityId").kendoDropDownList({
                dataTextField: "name",
                dataValueField: "id",
                optionLabel: "ابتدا استان را انتخاب کنید...",
                enable: false,
                dataSource: {
                    data: []
                }
            }).data("kendoDropDownList");

            // ============ تابع بارگذاری شهرها ============
            function loadCities(provinceId) {
                if (!provinceId) return;

                var cityDropDown = $("#CityId").data("kendoDropDownList");
                cityDropDown.text("در حال بارگذاری...");
                cityDropDown.enable(false);

                $.ajax({
                    url: '@Url.Action("GetCitiesByProvinceForDropDown", LoanController.CONTROLLER)',
                    type: 'POST',
                    data: { provinceId: provinceId },
                    dataType: 'json',
                    success: function(response) {
                        console.log("Cities Response:", response);

                        if (response.data && response.data.length > 0) {
                            cityDropDown.setDataSource(new kendo.data.DataSource({
                                data: response.data
                            }));

                            cityDropDown.enable(true);
                            cityDropDown.value("");

                            // اگر در حالت Edit هستیم
                            @if (Model.LoanData?.CityId != null)
                            {
                                        <text>
                                        var cityId = '@Model.LoanData.CityId';
                                        cityDropDown.value(cityId);
                                        </text>
                            }
                        } else {
                            cityDropDown.setDataSource([]);
                            cityDropDown.enable(false);
                            toastr.warning('شهری برای این استان یافت نشد');
                        }
                    },
                    error: function(xhr, status, error) {
                        console.error('Error loading cities:', error);
                        cityDropDown.setDataSource([]);
                        cityDropDown.enable(false);
                        toastr.error('خطا در بارگذاری لیست شهرها');
                    }
                });
            }

            // ============ Format Amount ============
            $('#Amount').on('keyup', function () {
                var input = $(this);
                var value = input.val().replace(/,/g, '');

                if (!/^\d*$/.test(value)) {
                    value = value.replace(/\D/g, '');
                }

                var formattedValue = value.replace(/\B(?=(\d{3})+(?!\d))/g, ",");
                input.val(formattedValue);
            });

            // ============ Submit Form ============
            var isSubmitting = false; // Flag to track submission state

            $("#submitBtn").click(function (e) {
                e.preventDefault();

                // Prevent double submission
                if (isSubmitting) {
                    return false;
                }

                // اعتبارسنجی
                var validator = $("#createLoanForm").kendoValidator({
                    rules: {
                        provinceRequired: function(input) {
                            if (input.is("#ProvinceId")) {
                                var value = $("#ProvinceId").data("kendoDropDownList").value();
                                return value !== "" && value !== null;
                            }
                            return true;
                        },
                        cityRequired: function(input) {
                            if (input.is("#CityId")) {
                                var value = $("#CityId").data("kendoDropDownList").value();
                                return value !== "" && value !== null;
                            }
                            return true;
                        }
                    },
                    messages: {
                        provinceRequired: "لطفا استان را انتخاب کنید",
                        cityRequired: "لطفا شهر را انتخاب کنید"
                    }
                }).data('kendoValidator');

                if (validator.validate()) {
                    console.log("Form is valid, submitting...");

                    // Disable submit button and change text
                    isSubmitting = true;
                    var $submitBtn = $("#submitBtn");
                    var originalValue = $submitBtn.val();

                    $submitBtn.prop('disabled', true)
                              .val('در حال ارسال...')
                              .css('cursor', 'not-allowed');

                    // Submit the form
                    $("#createLoanForm").submit();

                    // Optional: Re-enable after timeout (safety measure if submission fails)
                    setTimeout(function() {
                        if (isSubmitting) {
                            $submitBtn.prop('disabled', false)
                                      .val(originalValue)
                                      .css('cursor', 'pointer');
                            isSubmitting = false;
                        }
                    }, 5000); // 5 seconds timeout

                } else {
                    toastr.error('لطفا تمام فیلدهای الزامی را پر کنید');
                }
            });

        });
    </script>
}