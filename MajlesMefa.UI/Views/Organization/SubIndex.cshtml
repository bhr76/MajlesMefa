@using MajlesMefa.UI.Views.Organization;
@{
    var organizationId = ViewBag.organizationId;
    ViewData["Title"] = ViewBag.organizationId == null ? "لیست سازمان‌ها" : "لیست سازمان‌ها";
    
}

<div class="home-page">
    <div class="m-portlet__body">
        <div class="k-rtl">
            <div id="report-grid"></div>
        </div>

    </div>
</div>

@section scripts{
    <script asp-append-version="true">
        var url_create = '@Url.Action(nameof(OrganizationController.Create), OrganizationController.CONTROLLER, new {organizationId=@ViewBag.organizationId})';
        var url_get = '@Url.Action(nameof(OrganizationController.GetOrganization), OrganizationController.CONTROLLER, new {organizationId=@ViewBag.organizationId})';
        var url_delete = '@Url.Action(nameof(OrganizationController.Delete), OrganizationController.CONTROLLER, new {organizationId=@ViewBag.organizationId})';
        var url_edit = '@Url.Action(nameof(OrganizationController.Edit), OrganizationController.CONTROLLER , new {organizationId=@ViewBag.organizationId})';
        var url_subOrg = '@Url.Action(nameof(OrganizationController.Index), OrganizationController.CONTROLLER)';
        var btns = `<button class="k-button mt-1" data-link="${url_delete}&id=#:id#"> حذف </button>
                                                    <button class="k-button mt-1" data-link="${url_edit}&name=#:name#&id=#:id#"><span class="k-icon k-i-edit"></span> ویرایش</button>
              `;
        
    </script>
    <script src="~/js/pages/organization.js" asp-append-version="true"></script>
    <script>
    $(document).ready(function () {
            if ('@organizationId' != "") {
                $("#subcategory-btn").addClass("d-hide");
        }
    });
    </script>
}

