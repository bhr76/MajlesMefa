@using MajlesMefa.UI.Models;
@using MajlesMefa.UI.Views.Soal;

@model SoalVm

@{
    Layout = null;
}

<form asp-controller=@SoalController.CONTROLLER asp-action="Delete" id="DeleteSoalbeForm" method="post">

    <div class="card" style="margin:10px;">
        <div class="card-header">
            <p class="mb-0">
                <b>حذف سوال - شناسه: @Model.SoalData.Id</b>
            </p>
        </div>

    <div class="modal-body">

        <div asp-validation-summary="ModelOnly"></div>
            <input asp-for="@Model.SoalData.Id" hidden />
            <input asp-for="@Model.SoalData" hidden />
        <div class="row"><div class="col-12"><br /></div></div>
        <div class="row">
            <div class="form-group col-6">
                <label asp-for="@Model.Title" class="control-label">عنوان سوال</label>
                    <input value="@Model.Title" class="form-control" disabled readonly />
            </div>
        </div>
        <div class="row"><div class="col-12"><br /></div></div>
        <div class="row"><div class="col-12"><br /></div></div>
        <div class="row">
            <div class="col-12">
                <div class="alert alert-danger" style="width:90%; margin:auto;">
                    آیا از انجام این عملیات مطمئن هستید؟
                </div>
                <br/>
            </div>
        </div>
       

    </div>
    <div class="modal-footer">

            <button onclick="event.preventDefault();saveAndupdate($(this.form), $(this.form).attr('action') , '#report-grid-soal' ) "
                class="btn btn-danger" perform="action">
            حذف
        </button>
    </div>
    </div>

</form>


