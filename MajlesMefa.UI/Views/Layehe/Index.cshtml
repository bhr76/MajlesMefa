@using MajlesMefa.UI.Views.Layehe;
@using MajlesMefa.Back.Services.Abstractioin;
@using MajlesMefa.Back.Enums;
@model Guid?
@{
    ViewData["Title"] = "لیست لایحه";
    var id = Model.HasValue ? Model : Guid.Empty;
    var user = Context.RequestServices.GetService<ICurrentUserService>();
    var role = user.GetCurrentUser().Roles.FirstOrDefault();
}

<div class="home-page">
    <div class="m-portlet__body">
        <div class="k-rtl">
            <div id="report-grid-layehe"></div>
        </div>

    </div>
</div>

@section scripts{
    <script asp-append-version="true">
        var fromReportPage = true;
        var url_get_layehe = '';
        var url_create = '';
        var url_edit = '';
        var url_delete = '';
        var fromReportPage = false;
          {
            if ('@id' == null || '@id' == @Guid.Empty) { url_get_layehe = '@Url.Action(nameof(LayeheController.GetLayehe), LayeheController.CONTROLLER)'; }
            else {
                url_get_layehe = '@Url.Action(nameof(LayeheController.GetLayehe), LayeheController.CONTROLLER)' + '?senatorId=@id';
            }
            if (@RoleTypeEnum.Admin.Equals(role).ToString().ToLower() || @RoleTypeEnum.MinistryAdmin.Equals(role).ToString().ToLower() || @RoleTypeEnum.MinistryMember.Equals(role).ToString().ToLower()) {
                url_create = '@Url.Action(nameof(LayeheController.Create), LayeheController.CONTROLLER)';
                url_edit = '@Url.Action(nameof(LayeheController.Edit), LayeheController.CONTROLLER)';
                url_delete = '@Url.Action(nameof(LayeheController.Delete), LayeheController.CONTROLLER)';
            }
        };
        var url_details = '@Url.Action(nameof(LayeheController.Details), LayeheController.CONTROLLER)';
        var btns = `<button class="k-button" data-link="${url_details}/?layeheId=#:id#">جزییات</button>
                                #if('${url_delete}' != ''){# <button class="k-button mt-1" data-link="${url_delete}/?layeheId=#:id#"> حذف </button>#}#
                                                                  #if('${url_edit}' != ''){#  <a class="k-button mt-1" href="${url_edit}?layeheId=#:id#"><span class="k-icon k-i-edit"></span> ویرایش</a>#}#
                        `;
    </script>
    <script src="~/js/pages/layehe.js" asp-append-version="true"></script>
  
    <script id="persianErjaBeShoraTemplate" type="text/x-kendo-template">
        #if( myData.erjaBeShoraDate ) {#
        #:moment(myData.erjaBeShoraDate).format('jYYYY/jMM/jDD - HH:mm:ss')#
        #}#
    </script>
    
}


