            //$("#BirthCityId").kendoDropDownList({
            //    dataTextField: "name",
            //    dataValueField: "id",
            //    filter: "contains",
            //    optionLabel: "یک آیتم انتخاب کنید...",
            //    dataSource: {}
            //});

            $("#CityId").change(
                function () {
                    if ($("#CityId").val()) {
                        var parentId = $("#CityId").val();
                        $("#HozeCityId").kendoDropDownList({
                            dataTextField: "name",
                            dataValueField: "id",
                            filter: "contains",
                            optionLabel: "یک آیتم انتخاب کنید...",
                            dataSource: {
                                transport: {
                                    read: {
                                        dataType: "json",
                                        contentType: 'application/json; charset=utf-8',
                                        url: '@Url.Action("GetCitiesForDropDown", CityController.CONTROLLER)',
                                    },
                                    parameterMap: function (options) {
                                        return `models=${kendo.stringify(options)}&parentId=${parentId}`;
                                    }
                                },
                                schema: {
                                    data: "data",
                                    total: "totalRecords",
                                    page: "page",
                                    pageSize: "pageSize"
                                },
                                serverFiltering: true
                            }
                        });
                    } else {

                        $("#HozeCityId").kendoDropDownList({
                            dataTextField: "name",
                            dataValueField: "id",
                            filter: "contains",
