@section scripts{
    <script>
        $(document).ready(function () {

            $("#ComissionMembership").kendoDropDownList({
                dataTextField: "title",
                dataValueField: "id",
                filter: "contains",
                optionLabel: "یک آیتم انتخاب کنید...",
                dataSource: {
                    transport: {
                        read: {
                            dataType: "json",
                            contentType: 'application/json; charset=utf-8',
                            url: '@Url.Action("GetCommission", CommissionController.CONTROLLER)',
                        },
                        parameterMap: function (options) {
                            return `models=${kendo.stringify(options)}`;
                        }
                    },
                    schema: {
                        data: "data",
                        total: "totalRecords",
                        page: "page",
                        pageSize: "pageSize"
                    },
                    serverFiltering: true
                }
            });

            $("#profilePhoto").change(
                function () {
                    var uploading = new FileReader();
                    uploading.onload = function (displayimg) {
                        $("#currentPhoto").addClass("d-none");
                        $("#Newphoto").attr('src', displayimg.target.result);
                    }
                    if (event.target.files.length > 0) {
                        uploading?.readAsDataURL(event.target.files[0]);
                    } else {
                        $("#Newphoto").addClass("d-none");
                        $("#currentPhoto").addClass("d-flex");
                    }

                }
            );


            $("#btnPassword").click(
                function () {
                    if ($('#btnPassword').hasClass("fa-eye")) {
                        $('#EditPassword').attr('type', 'text');
                        $('#btnPassword').removeClass('fa-eye').addClass('fa-eye-slash');
                    } else {
                        $('#EditPassword').attr('type', 'password');
                        $('#btnPassword').removeClass('fa-eye-slash').addClass('fa-eye');
                    }
                }
            );

            $("#btnConfirmPassword").click(
                function () {
                    if ($('#btnConfirmPassword').hasClass("fa-eye")) {
                        $('#EditConfirmPassword').attr('type', 'text');
                        $('#btnConfirmPassword').removeClass('fa-eye').addClass('fa-eye-slash');
                    } else {
                        $('#EditConfirmPassword').attr('type', 'password');
                        $('#btnConfirmPassword').removeClass('fa-eye-slash').addClass('fa-eye');
                    }
                }
            );

            $('#btnBirthdate').MdPersianDateTimePicker({
                targetTextSelector: '#BirthdateString',
                dateFormat: 'yyyy-MM-dd',
                dateFormat: 'yyyy-MM-dd',
                isGregorian: false,
                enableTimePicker: false,
                disableBeforeToday: false,
                modalMode: true,
                inLine: false
            });


            $("#HozeEntekhabiInt").kendoDropDownList({
                dataTextField: "name",
                dataValueField: "id",
                optionLabel: "یک آیتم انتخاب کنید...",
                dataSource: {
                    transport: {
                        read: {
                            dataType: "json",
                            contentType: 'application/json; charset=utf-8',
                            url: '@Url.Action("GetHozeEntekhabiForDropDown", SenatorController.CONTROLLER)',
                        },
                    },
                    serverFiltering: false
                }
            });

            $("#ShoghleGhalebInt").kendoDropDownList({
