@using MajlesMefa.UI.Views.Category;
@using MajlesMefa.UI.Views.Commission;
@using MajlesMefa.UI.Views.Mokatebe;
@using MajlesMefa.UI.Models;
@using MajlesMefa.UI.Views.Senator;
@using MajlesMefa.UI.Views.TahghighTafahos;
@{
    var firstParentId = Model.CategoryParentId;
    var a = Model;
    ViewData["Title"] = "ویرایش تحقیق و تفحص";
}
@model TahghighTafahosVm

<div class="m-portlet">
    <div class="m-portlet__body">
        <form asp-controller=@TahghighTafahosController.CONTROLLER asp-action="Edit" id="EditTahghighTafahosForm" method="post">
            <div class="row">
                <div asp-validation-summary="ModelOnly"></div>
                <input asp-for="@Model.TafahosData.Id" hidden />

                <div class="form-group mt-3 col-md-4">
                    <label asp-for="@Model.SenatorId"></label>
                    <input asp-for="@Model.SenatorId" id="SenatorId" class="form-control" />
                    <span asp-validation-for="@Model.SenatorId" class="text-danger"></span>
                </div>

                <div class="form-group mt-3 col-12 mb-4">
                    <label asp-for="@Model.TafahosData.TahghighTafahosSenatorsId"></label>
                    <select class="form-control h-100" asp-for="@Model.TafahosData.TahghighTafahosSenatorsId" id="TahghighTafahosSenators" multiple="multiple">
                    </select>
                    <span asp-validation-for="@Model.TafahosData.TahghighTafahosSenatorsId" class="text-danger"></span>
                </div>

                <div class="form-group mt-3 col-md-4">
                    <label asp-for="@Model.Title"></label>
                    <input asp-for="@Model.Title" id="Title" class="form-control" />
                    <span asp-validation-for="@Model.Title" class="text-danger"></span>
                </div>

                <div class="form-group mt-3 col-md-4">
                    <label asp-for="@Model.TafahosData.ShomareName"></label>
                    <input asp-for="@Model.TafahosData.ShomareName" id="ShomareName" class="form-control" />
                    <span asp-validation-for="@Model.TafahosData.ShomareName" class="text-danger"></span>
                </div>

                <div class="form-group mt-3 col-md-4">
                    <label asp-for="@Model.TafahosData.ShomareDaryaft"></label>
                    <input asp-for="@Model.TafahosData.ShomareDaryaft" id="ShomareDaryaft" class="form-control" />
                    <span asp-validation-for="@Model.TafahosData.ShomareDaryaft" class="text-danger"></span>
                </div>


                <div class="form-group mt-3 col-md-4">
                    <label asp-for="@Model.Date" class="control-label"></label>
                    <div class="input-group">
                        <div class="input-group-prepend">
                            <span class="input-group-text cursor-pointer" id="btnTarikh"><i class="far fa-calendar-alt"></i></span>
                        </div>
                        <input asp-for="@Model.Date" class="form-control" />
                    </div>
                    <span class="help-block"><span asp-validation-for="@Model.Date" class="text-danger"></span></span>
                </div>

                <div class="form-group mt-3 col-md-4">
                    <label asp-for="@Model.TafahosData.Commission"></label>
                    <input asp-for="@Model.TafahosData.Commission" id="Commission" class="form-control" />
                    <span asp-validation-for="@Model.TafahosData.Commission" class="text-danger"></span>
                </div>
                <div class="form-group mt-3 col-md-4">
                    <label asp-for="@Model.TafahosData.Mokhatab" class="control-label"></label>
                    <input asp-for="@Model.TafahosData.Mokhatab" id="Mokhatab" class="form-control" />
                    <span asp-validation-for="@Model.TafahosData.Mokhatab" class="text-danger"></span>
                </div>
                <div class="form-group mt-3 col-md-4">
                    <label asp-for="@Model.TafahosData.TahghighTafahosVazyatInt"></label>
                    <input asp-for="@Model.TafahosData.TahghighTafahosVazyatInt" id="TahghighTafahosVazyat" class="form-control" />
                    <span asp-validation-for="@Model.TafahosData.TahghighTafahosVazyatInt" class="text-danger"></span>
                </div>
                <div class="form-group col-12 mt-4">
                    <input asp-for="@Model.Moshtarak" id="Moshtarak" default="@Model.Moshtarak" />
                    <label asp-for="@Model.Moshtarak">معاونت مشترک دارد</label>
                </div>

                <div id="category" class="col-12 row">
                    <div class="form-group mt-3 col-md-4">
                        <label asp-for="@Model.CategoryParentId"></label>
                        <input asp-for="@Model.CategoryParentId" id="CategoryParentId" class="form-control" />
                    </div>
                    <div class="form-group mt-3 col-md-4">
                        <label asp-for="@Model.CategoryId"></label>
                        <input asp-for="@Model.CategoryId" id="CategoryId" class="form-control" />
                        <span asp-validation-for="@Model.CategoryId" class="text-danger"></span>
                    </div>
                </div>

                <div class="form-group mt-3 col-md-12" id="moavenats">
                    <label asp-for="@Model.Moavenats"></label>
                    <select class="form-control" asp-for="@Model.Moavenats" id="Moavenats" multiple="multiple">
                    </select>
                    <span asp-validation-for="@Model.Moavenats" class="text-danger"></span>
                </div>

                <div class="form-group mt-3 col-md-6">
                    <label asp-for="@Model.Description"></label>
                    <textarea asp-for="@Model.Description" id="Description" class="form-control" rows="4"></textarea>
                    <span asp-validation-for="@Model.Description" class="text-danger"></span>
                </div>



            </div>
            <div class="row">
                <div class="submit-btn col-md-3 m-auto">
                    <input type="submit" value="ثبت" />
                </div>
            </div>

        </form>
    </div>
</div>
@section scripts{
    <script>
        $(document).ready(function () {

            $("#TahghighTafahosSenators").kendoMultiSelect({
                includeSelectAllOption: true,
                dataTextField: "name",
                dataValueField: "id",
                template: "<span>#:data.name# -  #:data.hozeCityName#</span>",
                filter: "contains",
                value: JSON.parse('@Html.Raw(Newtonsoft.Json.JsonConvert.SerializeObject(@ViewBag.SenatorsDefaultValue))'),
                optionLabel: "یک آیتم انتخاب کنید...",
                dataSource: {
                    transport: {
                        read: {
                            dataType: "json",
                            contentType: 'application/json; charset=utf-8',
                            url: '@Url.Action("GetSenatorsForMultiSelect", SenatorController.CONTROLLER)',
                        },
                    },
                    schema: {
                        data: "data",
                        total: "totalRecords",
                        page: "page",
                        pageSize: "pageSize"
                    },
                    serverFiltering: false
                }
            });

            var jsonList = '@Html.Raw(Newtonsoft.Json.JsonConvert.SerializeObject(@ViewBag.MoavenatsDefaultValue))';

            var jsList = JSON.parse(jsonList);

            if (jsList) {
                $("#moavenats").show();
                $("#category").hide();
            } else {
                $("#moavenats").hide();
                $("#category").show();
            }
            $("#Moshtarak").change(function (event) {
                $("#moavenats").toggle();
                $("#category").toggle();
            });
            $("#Moavenats").kendoMultiSelect({
                includeSelectAllOption: true,
                dataTextField: "name",
                dataValueField: "id",
                optionLabel: "یک آیتم انتخاب کنید...",
                value: jsList,
                filter: "contains",
                optionLabel: "یک آیتم انتخاب کنید...",
                dataSource: {
                    transport: {
                        read: {
                            dataType: "json",
                            contentType: 'application/json; charset=utf-8',
                            url: '@Url.Action("GetCategoriesForMultiSelect", CategoryController.CONTROLLER)',
                        },
                    },
                    schema: {
                        data: "data",
                        total: "totalRecords",
                        page: "page",
                        pageSize: "pageSize"
                    },
                    serverFiltering: false
                }
            });

            $("#CategoryParentId").kendoDropDownList({
                dataTextField: "name",
                dataValueField: "id",
                filter: "contains",
                optionLabel: "یک آیتم انتخاب کنید...",
                dataSource: {
                    transport: {
                        read: {
                            dataType: "json",
                            contentType: 'application/json; charset=utf-8',
                            url: '@Url.Action("GetCategoriesForDropDown", CategoryController.CONTROLLER)',
                        },
                        parameterMap: function (options) {
                            return `models=${kendo.stringify(options)}`;
                        }
                    },
                    schema: {
                        data: "data",
                        total: "totalRecords",
                        page: "page",
                        pageSize: "pageSize"
                    },
                    serverFiltering: true
                }
            });

            $("#CategoryId").kendoDropDownList({
                dataTextField: "name",
                dataValueField: "id",
                filter: "contains",
                optionLabel: "یک آیتم انتخاب کنید...",
                dataSource: {
                    transport: {
                        read: {
                            dataType: "json",
                            contentType: 'application/json; charset=utf-8',
                            url: '@Url.Action("GetCategoriesForDropDown", CategoryController.CONTROLLER)',
                        },
                        parameterMap: function (options) {
                            return `models=${kendo.stringify(options)}&parentId=@firstParentId`;
                        }
                    },
                    schema: {
                        data: "data",
                        total: "totalRecords",
                        page: "page",
                        pageSize: "pageSize"
                    },
                    serverFiltering: true
                }
            });

            $("#CategoryParentId").change(
                function () {
                    if ($("#CategoryParentId").val()) {
                        console.log("if", $("#CategoryParentId").val());
                        var parentId = $("#CategoryParentId").val();
                        $("#CategoryId").kendoDropDownList({
                            dataTextField: "name",
                            dataValueField: "id",
                            filter: "contains",
                            optionLabel: "یک آیتم انتخاب کنید...",
                            dataSource: {
                                transport: {
                                    read: {
                                        dataType: "json",
                                        contentType: 'application/json; charset=utf-8',
                                        url: '@Url.Action("GetCategoriesForDropDown", CategoryController.CONTROLLER)',
                                    },
                                    parameterMap: function (options) {
                                        return `models=${kendo.stringify(options)}&parentId=${parentId}`;
                                    }
                                },
                                schema: {
                                    data: "data",
                                    total: "totalRecords",
                                    page: "page",
                                    pageSize: "pageSize"
                                },
                                serverFiltering: true
                            }
                        });
                    } else {
                        console.log("hi", $("#CategoryParentId").val());

                        $("#CategoryId").kendoDropDownList({
                            dataTextField: "name",
                            dataValueField: "id",
                            filter: "contains",
                            optionLabel: "یک آیتم انتخاب کنید...",
                            dataSource: {}
                        });
                    }
                });

            $("#CategoryId").change(
                function () {
                    var id = $("#CategoryId").val();
                    if (id != "") {
                        $.ajax({
                            url: "@Url.Action("GetCategoryById", CategoryController.CONTROLLER)",
                            type: "POST",
                            data: { categoryId: id },
                            dataType: "json",
                            success: function (response) {
                                if (response.hasAmount) {
                                    $("#Amount").show();
                                } else {
                                    $("#Amount").hide();
                                    $("#amount-input").val('');
                                }
                            }
                        });
                    } else {
                        $("#Amount").hide();
                        $("#amount-input").val('');
                    }
                }
            );

            $("#Commission").kendoDropDownList({
                dataTextField: "title",
                dataValueField: "id",
                filter: "contains",
                optionLabel: "یک آیتم انتخاب کنید...",
                dataSource: {
                    transport: {
                        read: {
                            dataType: "json",
                            contentType: 'application/json; charset=utf-8',
                            url: '@Url.Action("GetCommission", CommissionController.CONTROLLER)',
                        },
                        parameterMap: function (options) {
                            return `models=${kendo.stringify(options)}`;
                        }
                    },
                    schema: {
                        data: "data",
                        total: "totalRecords",
                        page: "page",
                        pageSize: "pageSize"
                    },
                    serverFiltering: true
                }
            });

            $('#btnTarikh').MdPersianDateTimePicker({
                targetTextSelector: '#Date',
                dateFormat: 'yyyy-MM-dd',
                dateFormat: 'yyyy-MM-dd',
                isGregorian: false,
                enableTimePicker: false,
                disableBeforeToday: false,
                modalMode: true,
                inLine: false
            });

            $("#TahghighTafahosVazyat").kendoDropDownList({
                dataTextField: "name",
                dataValueField: "id",
                optionLabel: "یک آیتم انتخاب کنید...",
                dataSource: {
                    transport: {
                        read: {
                            dataType: "json",
                            contentType: 'application/json; charset=utf-8',
                            url: '@Url.Action("GetVazyatForDropDown", TahghighTafahosController.CONTROLLER)',
                        },
                    },
                    serverFiltering: false
                }
            });

            $("#SenatorId").kendoDropDownList({
                dataTextField: "name",
                dataValueField: "id",
                filter: "contains",
                template: "<span>#:data.name# -  #:data.hozeCityName#</span>",
                optionLabel: "یک آیتم انتخاب کنید...",
                dataSource: {
                    transport: {
                        read: {
                            dataType: "json",
                            contentType: 'application/json; charset=utf-8',
                            url: '@Url.Action("GetSenatorsForDropDown", SenatorController.CONTROLLER)',
                        },
                        parameterMap: function (options) {
                            return `models=${kendo.stringify(options)}`;
                        }
                    },
                    schema: {
                        data: "data",
                        total: "totalRecords",
                        page: "page",
                        pageSize: "pageSize"
                    },
                    serverFiltering: true
                }
            });



        });

    </script>
}