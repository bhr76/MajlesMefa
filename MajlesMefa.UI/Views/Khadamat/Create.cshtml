@using MajlesMefa.UI.Views.Khadamat;
@using MajlesMefa.UI.Views.Senator;
@{
    ViewData["Title"] = "ایجاد خدمت";
}
@model KhadamatVm

<div class="m-portlet">
    <div class="m-portlet__body">
        <form asp-controller=@KhadamatController.CONTROLLER asp-action="Create" id="createKhadamatForm" method="post">
            <div class="row">
                <div asp-validation-summary="ModelOnly"></div>

                <div class="form-group mt-3 col-md-4">
                    <label asp-for="@Model.SenatorId"></label>
                    <input asp-for="@Model.SenatorId" id="SenatorId" class="form-control" />
                    <span asp-validation-for="@Model.SenatorId" class="text-danger"></span>
                </div>

                <div class="form-group mt-3 col-md-4">
                    <label asp-for="@Model.Title">عنوان</label>
                    <input asp-for="@Model.Title" id="Title" class="form-control" />
                    <span asp-validation-for="@Model.Title" class="text-danger"></span>
                </div>
                <div class="form-group mt-3 col-md-4">
                    <label asp-for="@Model.TarikhKhedmat" class="control-label"></label>
                    <div class="input-group">
                        <div class="input-group-prepend">
                            <span class="input-group-text cursor-pointer" id="btnTarikhKhedmat"><i class="far fa-calendar-alt"></i></span>
                        </div>
                        <input asp-for="@Model.TarikhKhedmat" class="form-control" />
                    </div>
                    <span class="help-block"><span asp-validation-for="@Model.TarikhKhedmat" class="text-danger"></span></span>
                </div>

                <div class="form-group mt-3 col-md-12">
                    <label asp-for="@Model.KhedmatData.Khedmat"></label>
                    <textarea asp-for="@Model.KhedmatData.Khedmat" id="Khedmat" class="form-control" rows="10"></textarea>
                    <span asp-validation-for="@Model.KhedmatData.Khedmat" class="text-danger"></span>
                </div>

                

                <div class="form-group mt-3 col-md-12">
                    <label asp-for="@Model.Description"></label>
                    <textarea asp-for="@Model.Description" id="Description" class="form-control" rows="4"></textarea>
                    <span asp-validation-for="@Model.Description" class="text-danger"></span>
                </div>

            </div>
            <div class="row">
                <div class="submit-btn col-md-3 m-auto">
                    <input id="submitBtn" type="submit" value="ثبت" />
                </div>
            </div>
        </form>
    </div>
</div>

@section scripts{
    <script>
        $(document).ready(function () {

            $('#btnTarikhKhedmat').MdPersianDateTimePicker({
                targetTextSelector: '#TarikhKhedmat',
                dateFormat: 'yyyy-MM-dd',
                dateFormat: 'yyyy-MM-dd',
                isGregorian: false,
                enableTimePicker: false,
                disableBeforeToday: false,
                modalMode: true,
                inLine: false
            });

            $("#SenatorId").kendoDropDownList({
                dataTextField: "name",
                dataValueField: "id",
                filter: "contains",
                template: "<span>#:data.name# -  #:data.hozeCityName#</span>",
                optionLabel: "یک آیتم انتخاب کنید...",
                dataSource: {
                    transport: {
                        read: {
                            dataType: "json",
                            contentType: 'application/json; charset=utf-8',
                            url: '@Url.Action("GetSenatorsForDropDown", SenatorController.CONTROLLER)',
                        },
                        parameterMap: function (options) {
                            return `models=${kendo.stringify(options)}`;
                        }
                    },
                    schema: {
                        data: "data",
                        total: "totalRecords",
                        page: "page",
                        pageSize: "pageSize"
                    },
                    serverFiltering: true,
                    filter: function (item) {
                        if (this.filterSource && this.filterSource.filter && this.filterSource.filter.filters.length > 0) {
                            var filter = this.filterSource.filter.filters[0];
                            var searchText = filter.value.toLowerCase();

                            // Search in both name and hozeCityName fields
                            return item.name.toLowerCase().indexOf(searchText) >= 0 ||
                                item.hozeCityName.toLowerCase().indexOf(searchText) >= 0;
                        }
                        return true;
                    }
                },
                filtering: function (e) {
                    // Get the filter value
                    var filterValue = e.filter ? e.filter.value : "";

                    // If server filtering is enabled, we need to modify the filter
                    if (this.dataSource.options.serverFiltering) {
                        // Prevent the default filtering
                        e.preventDefault();

                        // Create a filter with "or" logic for both fields
                        var filter = {
                            logic: "or",
                            filters: [
                                { field: "name", operator: "contains", value: filterValue },
                                { field: "hozeCityName", operator: "contains", value: filterValue }
                            ]
                        };

                        // Apply the custom filter
                        this.dataSource.filter(filter);
                    }
                }
            });

            $("#submitBtn").click(function () {
                var validator = $("#createKhadamatForm").kendoValidator().data('kendoValidator');
                validator.validate();
            });

        });
    </script>
}