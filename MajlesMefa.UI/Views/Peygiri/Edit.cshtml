@using MajlesMefa.UI.Models;
@using MajlesMefa.UI.Views.Organization;
@using MajlesMefa.UI.Views.Peygiri;
@{
    Layout = null;
}
@model PeygiriVm

<form asp-controller=@PeygiriController.CONTROLLER asp-action="Edit" id="editPeygiriForm" method="post">

    <div class="card" style="margin:10px;">
        <div class="card-header">
            <p class="mb-0">
                <b>ویرایش پیگیری - کد پیگیری: @Model.Id</b>
            </p>
        </div>
        <div class="modal-body">
            <div class="row">
                <div asp-validation-summary="ModelOnly"></div>

                <input hidden asp-for="@Model.Id" />

                <div class="form-group mt-3 col-md-4">
                    <label asp-for="@Model.PeygiriKonandeId"></label>
                    <input asp-for="@Model.PeygiriKonandeId" id="PeygiriKonande" class="form-control" />
                    <span asp-validation-for="@Model.PeygiriKonandeId" class="text-danger"></span>
                </div>

                <div class="form-group mt-3 col-md-4">
                    <label asp-for="@Model.PeygiriNumber"></label>
                    <input asp-for="@Model.PeygiriNumber" id="PeygiriNumber" class="form-control" />
                    <span asp-validation-for="@Model.PeygiriNumber" class="text-danger"></span>
                </div>

                <div class="form-group mt-3 col-md-4">
                    <label asp-for="@Model.PeygiriDatePicker" class="control-label"></label>
                    <div class="input-group">
                        <div class="input-group-prepend">
                            <span class="input-group-text cursor-pointer" id="btnTarikhPeygiri"><i class="far fa-calendar-alt"></i></span>
                        </div>
                        <input asp-for="@Model.PeygiriDatePicker" class="form-control" />
                    </div>
                    <span class="help-block"><span asp-validation-for="@Model.PeygiriDatePicker" class="text-danger"></span></span>
                </div>

                <div class="form-group mt-3 col-md-12">
                    <label asp-for="@Model.PeygiriDescription"></label>
                    <textarea asp-for="@Model.PeygiriDescription" id="PeygiriDescription" class="form-control" rows="4"></textarea>
                    <span asp-validation-for="@Model.PeygiriDescription" class="text-danger"></span>
                </div>

            </div>
        </div>
        <div class="modal-footer">
           <button onclick="event.preventDefault();saveAndupdate($(this.form), $(this.form).attr('action'));"
                    class="btn btn-warning" perform="action">
                ثبت
            </button>
        </div>
    </div>

</form>



<script>
    $(document).ready(function () {

        $("#PeygiriKonande").kendoDropDownList({
            dataTextField: "name",
            dataValueField: "id",
            filter: "contains",
            optionLabel: "یک آیتم انتخاب کنید...",
            dataSource: {
                transport: {
                    read: {
                        dataType: "json",
                        contentType: 'application/json; charset=utf-8',
                        url: '@Url.Action("GetOrganizationsForDropDown", OrganizationController.CONTROLLER)',
                    },
                    parameterMap: function (options) {
                        return `models=${kendo.stringify(options)}`;
                    }
                },
                schema: {
                    data: "data",
                    total: "totalRecords",
                    page: "page",
                    pageSize: "pageSize"
                },
                serverFiltering: true
            }
        });

        $('#btnTarikhPeygiri').MdPersianDateTimePicker({
            targetTextSelector: '#PeygiriDatePicker',
            dateFormat: 'yyyy-MM-dd',
            dateFormat: 'yyyy-MM-dd',
            isGregorian: false,
            enableTimePicker: false,
            disableBeforeToday: false,
            modalMode: true,
            inLine: false
        });

    });

</script>
