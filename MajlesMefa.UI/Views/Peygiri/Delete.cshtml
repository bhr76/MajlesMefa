@using MajlesMefa.UI.Views.Peygiri;
@using MajlesMefa.UI.Models;

@model PeygiriVm

@{
    Layout = null;
}

<form asp-controller=@PeygiriController.CONTROLLER asp-action="Delete" id="DeletePeygiriForm" method="post">

    <div class="card" style="margin:10px;">
        <div class="card-header">
            <p class="mb-0">
                <b>حذف پیگیری - شناسه: @Model.Id</b>
            </p>
        </div>
        <div class="modal-body">

            <div asp-validation-summary="ModelOnly"></div>
            <input asp-for="@Model.Id" hidden />

            <div class="row"><div class="col-12"><br /></div></div>
            <div class="row">
                <div class="form-group col-6">
                    <label asp-for="@Model.PeygiriKonandeTitle" class="control-label"></label>
                    <input value="@Model.PeygiriKonandeTitle" class="form-control" disabled readonly />
                </div>

                <div class="form-group col-6">
                    <label asp-for="@Model.PeygiriDateStr" class="control-label"></label>
                    <input value="@Model.PeygiriDateStr" class="form-control" disabled readonly />
                </div>

                <div class="form-group col-6">
                    <label asp-for="@Model.PeygiriDescription" class="control-label"></label>
                    <input value="@Model.PeygiriDescription" class="form-control" disabled readonly />
                </div>
            </div>
            <div class="row"><div class="col-12"><br /></div></div>
            <div class="row"><div class="col-12"><br /></div></div>
            <div class="row">
                <div class="col-12">
                    <div class="alert alert-danger" style="width:90%; margin:auto;">
                        آیا از انجام این عملیات مطمئن هستید؟
                    </div>
                    <br />
                </div>
            </div>


        </div>
        <div class="modal-footer">

            <button onclick="event.preventDefault();saveAndupdate($(this.form), $(this.form).attr('action'));"
                    class="btn btn-danger" perform="action">
                حذف
            </button>
        </div>
    </div>

</form>


